%pk9 = index.add %pkb, %dim9 : index
%kn9 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pk9) : (index, buffer, index, index) -> (f32)
%pq10 = index.add %pb, %dim10 : index
%qn10 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pq10) : (index, buffer, index, index) -> (f32)
%pk10 = index.add %pkb, %dim10 : index
%kn10 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pk10) : (index, buffer, index, index) -> (f32)
%pq11 = index.add %pb, %dim11 : index
%qn11 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pq11) : (index, buffer, index, index) -> (f32)
%pk11 = index.add %pkb, %dim11 : index
%kn11 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pk11) : (index, buffer, index, index) -> (f32)
%pq12 = index.add %pb, %dim12 : index
%qn12 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pq12) : (index, buffer, index, index) -> (f32)
%pk12 = index.add %pkb, %dim12 : index
%kn12 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pk12) : (index, buffer, index, index) -> (f32)
%pq13 = index.add %pb, %dim13 : index
%qn13 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pq13) : (index, buffer, index, index) -> (f32)
%pk13 = index.add %pkb, %dim13 : index
%kn13 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pk13) : (index, buffer, index, index) -> (f32)
%pq14 = index.add %pb, %dim14 : index
%qn14 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pq14) : (index, buffer, index, index) -> (f32)
%pk14 = index.add %pkb, %dim14 : index
%kn14 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pk14) : (index, buffer, index, index) -> (f32)
%pq15 = index.add %pb, %dim15 : index
%qn15 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pq15) : (index, buffer, index, index) -> (f32)
