%valuebase = index.mul %head, %dim : index
%vchannel0 = index.add %valuebase, %channel : index
%vchannel = index.add %vchannel0, %column_lane : index
%eps = scalar.constant 1.0e-6 : f32
%qscale = scalar.constant 0.08838834764831845 : f32
%j0 = index.constant 0 : index
