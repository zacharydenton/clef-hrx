%vi0 = index.add %vchannel, %vc0 : index
%last0_0, %last0_1, %last0_2, %last0_3, %last0_4, %last0_5, %last0_6, %last0_7, %last0_8, %last0_9, %last0_10, %last0_11, %last0_12, %last0_13, %last0_14, %last0_15 = scf.for %t = [%zero to %seq step %one](%s0_0 = %fzero : f32, %s0_1 = %fzero : f32, %s0_2 = %fzero : f32, %s0_3 = %fzero : f32, %s0_4 = %fzero : f32, %s0_5 = %fzero : f32, %s0_6 = %fzero : f32, %s0_7 = %fzero : f32, %s0_8 = %fzero : f32, %s0_9 = %fzero : f32, %s0_10 = %fzero : f32, %s0_11 = %fzero : f32, %s0_12 = %fzero : f32, %s0_13 = %fzero : f32, %s0_14 = %fzero : f32, %s0_15 = %fzero : f32) -> (f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32) {
%qb0 = index.mul %t, %qwidth : index
%qb = index.add %qb0, %keybase : index
%kb = index.add %qb, %keyoff : index
%vb = index.add %qb0, %valueoff : index
%ob = index.mul %t, %vwidth : index
%ab0 = index.mul %t, %heads : index
%ai = index.add %ab0, %head : index
%pwidth = index.constant 4192 : index
%gateoff = index.constant 4096 : index
%two = index.constant 2 : index
%pb0 = index.mul %t, %pwidth : index
%pb = index.add %pb0, %keybase : index
%pkb = index.add %pb, %keyoff : index
%gatebase = index.add %pb0, %gateoff : index
%head2 = index.mul %head, %two : index
%gi = index.add %gatebase, %head2 : index
%bi = index.add %gi, %one : index
%decay = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %gi) : (index, buffer, index, index) -> (f32)
%beta = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %bi) : (index, buffer, index, index) -> (f32)
%pq0 = index.add %pb, %dim0 : index
%qn0 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pq0) : (index, buffer, index, index) -> (f32)
%pk0 = index.add %pkb, %dim0 : index
%kn0 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pk0) : (index, buffer, index, index) -> (f32)
%pq1 = index.add %pb, %dim1 : index
%qn1 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pq1) : (index, buffer, index, index) -> (f32)
%pk1 = index.add %pkb, %dim1 : index
%kn1 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pk1) : (index, buffer, index, index) -> (f32)
%pq2 = index.add %pb, %dim2 : index
%qn2 = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %pq2) : (index, buffer, index, index) -> (f32)
