// Experimental INT4 group-64 packing; generated by omni_attention_int4_candidate.py.
// Legacy INT8 export/config names retain the 36-word benchmark ABI.
// Layout: 16 INT4 words, 16 zeros, two group scales, two zeros.
// Experimental per-head INT4 group-64 Q/K packing. One wave quantizes 128 BF16 values.
// Quantization/packing adapted from h3-hrx prepare_qk_i8hm.loom, revision
// 95ed12f43bd3e596cbfad175c22de9560447e9e5 (Apache-2.0); no rotation.
// Each head stores 16 packed words, 16 zeros, two FP32 scales and two zeros.
amdgpu.target<gfx1151> @clef_qk_i8_target {subgroup_size = 32}
config.decl @clef.qk_i8.width : %value: index where [range(%value, 128, 65536), multiple_of(%value, 128)]
kernel.def target(@clef_qk_i8_target) export("clef_prepare_qk_int8") @clef_prepare_qk_int8(%rows: index) {
 %one = index.constant 1 : index
 %c32 = index.constant 32 : index
 %c128 = index.constant 128 : index
 %width = config.get @clef.qk_i8.width : index
 %heads = index.div %width, %c128 : index
 %groups = index.mul %rows, %heads : index
 kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%c32, %one, %one) : index
} launch(%rows: index, %input: buffer, %output: buffer) {
 %c0 = index.constant 0 : index
 %c1 = index.constant 1 : index
 %c4 = index.constant 4 : index
 %c28 = index.constant 28 : index
 %c32 = index.constant 32 : index
 %c36 = index.constant 36 : index
 %c128 = index.constant 128 : index
 %off = index.constant 0 : offset
 %width = config.get @clef.qk_i8.width : index
 %heads = index.div %width, %c128 : index
 %out_width = index.mul %heads, %c36 : index
 %count = index.assume %rows [range(%rows, 1, 65536)] : index
 %groups = index.mul %count, %heads : index
 %group0 = kernel.workgroup.id<x> : index
 %group = index.assume %group0 [lt(%group0, %groups)] : index
 %row0 = index.div %group, %heads : index
 %row = index.assume %row0 [lt(%row0, %count)] : index
 %head = index.rem %group, %heads : index
 %lane = kernel.workitem.id<x> : index
 %head_col = index.mul %head, %c128 : index
 %lane_col = index.mul %lane, %c4 : index
 %col0 = index.add %head_col, %lane_col : index
 %limit = index.sub %width, %c4 : index
 %col = index.assume %col0 [le(%col0, %limit), multiple_of(%col0, 4)] : index
 %ig = buffer.assume.memory_space<global> %input : buffer
 %og = buffer.assume.memory_space<global> %output : buffer
 %iv = buffer.view %ig[%off] : buffer -> view<[%count]x[%width]xbf16>
 %ov = buffer.view %og[%off] : buffer -> view<[%count]x[%out_width]xi32>
 %sv = buffer.view %og[%off] : buffer -> view<[%count]x[%out_width]xf32>
 %h = vector.load %iv[%row, %col] : view<[%count]x[%width]xbf16> -> vector<4xbf16>
 %x = vector.extf %h : vector<4xbf16> to vector<4xf32>
 %absolute = vector.absf %x : vector<4xf32>
 %zero = scalar.constant 0.0 : f32
 %tiny = scalar.constant 1e-30 : f32
 %qmax = scalar.constant 7.0 : f32
 %hi = vector.constant 7.0 : vector<4xf32>
 %lo = vector.constant -7.0 : vector<4xf32>
 %mask = vector.constant 15 : vector<4xi32>
 %local_max = vector.reduce<maxnumf> %absolute, %zero : vector<4xf32>, f32
 %i4_wave_width = scalar.constant 32 : i32
 %i4_delta1 = scalar.constant 1 : i32
 %i4_other1, %i4_valid1 = kernel.subgroup.shuffle<xor> %local_max, %i4_delta1, %i4_wave_width : f32, i32, i32
 %i4_max1 = scalar.maxnumf %local_max, %i4_other1 : f32
 %i4_delta2 = scalar.constant 2 : i32
 %i4_other2, %i4_valid2 = kernel.subgroup.shuffle<xor> %i4_max1, %i4_delta2, %i4_wave_width : f32, i32, i32
 %i4_max2 = scalar.maxnumf %i4_max1, %i4_other2 : f32
 %i4_delta4 = scalar.constant 4 : i32
 %i4_other4, %i4_valid4 = kernel.subgroup.shuffle<xor> %i4_max2, %i4_delta4, %i4_wave_width : f32, i32, i32
 %i4_max4 = scalar.maxnumf %i4_max2, %i4_other4 : f32
 %i4_delta8 = scalar.constant 8 : i32
 %i4_other8, %i4_valid8 = kernel.subgroup.shuffle<xor> %i4_max4, %i4_delta8, %i4_wave_width : f32, i32, i32
 %i4_max8 = scalar.maxnumf %i4_max4, %i4_other8 : f32
 %row_max = scalar.maxnumf %i4_max8, %tiny : f32
 %maximum = scalar.maxnumf %row_max, %tiny : f32
 %scale = scalar.divf %maximum, %qmax : f32
 %inverse = scalar.divf %qmax, %maximum : f32
 %ivector = vector.splat %inverse : vector<4xf32>
 %scaled = vector.mulf %x, %ivector : vector<4xf32>
 %rounded = vector.roundevenf %scaled : vector<4xf32>
 %lower = vector.maxnumf %rounded, %lo : vector<4xf32>
 %upper = vector.minnumf %lower, %hi : vector<4xf32>
 %signed = vector.fptosi %upper : vector<4xf32> to vector<4xi32>
 %bytes = vector.andi %signed, %mask : vector<4xi32>
 %b0 = vector.extract %bytes[0] : vector<4xi32> -> i32
 %b1 = vector.extract %bytes[1] : vector<4xi32> -> i32
 %b2 = vector.extract %bytes[2] : vector<4xi32> -> i32
 %b3 = vector.extract %bytes[3] : vector<4xi32> -> i32
 %s8 = scalar.constant 4 : i32
 %s16 = scalar.constant 8 : i32
 %s24 = scalar.constant 12 : i32
 %p1 = scalar.shli %b1, %s8 : i32
 %p2 = scalar.shli %b2, %s16 : i32
 %p3 = scalar.shli %b3, %s24 : i32
 %a = scalar.ori %b0, %p1 : i32
 %b = scalar.ori %p2, %p3 : i32
 %word = scalar.ori %a, %b : i32
 %i4_partner, %i4_partner_valid = kernel.subgroup.shuffle<xor> %word, %i4_delta1, %i4_wave_width : i32, i32, i32
 %i4_shift16 = scalar.constant 16 : i32
 %i4_upper = scalar.shli %i4_partner, %i4_shift16 : i32
 %i4_word = scalar.ori %word, %i4_upper : i32
 %i4_two = index.constant 2 : index
 %i4_sixteen = index.constant 16 : index
 %i4_thirtyfour = index.constant 34 : index
 %i4_zero = scalar.constant 0 : i32
 %base = index.mul %head, %c36 : index
 %i4_parity = index.rem %lane, %i4_two : index
 %i4_even = index.cmp eq, %i4_parity, %c0 : index
 scf.if %i4_even {
  %i4_word_index = index.div %lane, %i4_two : index
  %i4_out0 = index.add %base, %i4_word_index : index
  %i4_out = index.assume %i4_out0 [lt(%i4_out0, %out_width)] : index
  view.store %i4_word, %ov[%row, %i4_out] : i32, view<[%count]x[%out_width]xi32>
 }
 %i4_low_half = index.cmp ult, %lane, %i4_sixteen : index
 scf.if %i4_low_half {
  %i4_pad_local = index.add %lane, %i4_sixteen : index
  %i4_pad0 = index.add %base, %i4_pad_local : index
  %i4_pad = index.assume %i4_pad0 [lt(%i4_pad0, %out_width)] : index
  view.store %i4_zero, %ov[%row, %i4_pad] : i32, view<[%count]x[%out_width]xi32>
 }
 %i4_group_lane = index.rem %lane, %i4_sixteen : index
 %i4_group_first = index.cmp eq, %i4_group_lane, %c0 : index
 scf.if %i4_group_first {
  %i4_group = index.div %lane, %i4_sixteen : index
  %i4_scale_local = index.add %c32, %i4_group : index
  %i4_scale0 = index.add %base, %i4_scale_local : index
  %i4_scale = index.assume %i4_scale0 [lt(%i4_scale0, %out_width)] : index
  view.store %scale, %sv[%row, %i4_scale] : f32, view<[%count]x[%out_width]xf32>
 }
 %i4_pad_last = index.cmp ult, %lane, %i4_two : index
 scf.if %i4_pad_last {
  %i4_last_local = index.add %lane, %i4_thirtyfour : index
  %i4_last0 = index.add %base, %i4_last_local : index
  %i4_last = index.assume %i4_last0 [lt(%i4_last0, %out_width)] : index
  view.store %i4_zero, %ov[%row, %i4_last] : i32, view<[%count]x[%out_width]xi32>
 }
 kernel.return
}
