// Experimental fused M16 x N32 gate/up projections and BF16-rounded SwiGLU.
// Prefetch K256 packed codes per row; consume ascending K16 matrix fragments.
// SPDX-License-Identifier: MIT AND Apache-2.0
// BF16 fragments and publishing adapted from gemm_bf16_tiled.loom
// (qwen-image-hrx / h3-hrx; see licenses/qwen-image-hrx-MIT.txt).
// INT4 operand encoding and tiled addressing follow gemm_integer_m128.loom
// (h3-hrx, Apache-2.0). A wave handles 16 routed rows x 32 gate and 32 up channels.
// Gather/scatter keeps activation packing and combine order unchanged.
// Each 16-row partition has its own wave; empty partitions exit before WMMA.
// Omni grouped INT4 experts. Shapes are compiler specializations.
amdgpu.target<gfx11-generic> @clef_target {subgroup_size = 32}
config.decl @clef.work : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.groups : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.out_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.out_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.x_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.x_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.w_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.w_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.routes_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.routes_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.xs_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.xs_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.ws_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.ws_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.tokens : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.topk : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.k : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.n : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.stride : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.input_routed : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.u_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.u_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.us_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.us_dtype : %value: index where [range(%value, 0, 4294967295)]
kernel.def target(@clef_target) export("clef_op") @clef_op() {
 %one = index.constant 1 : index
 %threads = index.constant 64 : index
 %basegroups = config.get @clef.groups : index
 %tokens = config.get @clef.tokens : index
 %c15 = index.constant 15 : index
 %c16 = index.constant 16 : index
 %rounded = index.add %tokens, %c15 : index
 %tiles = index.div %rounded, %c16 : index
 %groups = index.mul %basegroups, %tiles : index
 kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%x_buffer: buffer, %w_buffer: buffer, %routes_buffer: buffer, %xs_buffer: buffer, %ws_buffer: buffer, %u_buffer: buffer, %us_buffer: buffer, %out_buffer: buffer) {
 %c0 = index.constant 0 : index
 %c1 = index.constant 1 : index
 %c2 = index.constant 2 : index
 %c4 = index.constant 4 : index
 %c8 = index.constant 8 : index
 %c16 = index.constant 16 : index
 %c32 = index.constant 32 : index
 %c64 = index.constant 64 : index
 %c128 = index.constant 128 : index
 %c256 = index.constant 256 : index
 %offset = index.constant 0 : offset
 %x_len = config.get @clef.x_len : index
 %x_dtype = config.get @clef.x_dtype : index
 %w_len = config.get @clef.w_len : index
 %w_dtype = config.get @clef.w_dtype : index
 %routes_len = config.get @clef.routes_len : index
 %routes_dtype = config.get @clef.routes_dtype : index
 %xs_len = config.get @clef.xs_len : index
 %xs_dtype = config.get @clef.xs_dtype : index
 %ws_len = config.get @clef.ws_len : index
 %ws_dtype = config.get @clef.ws_dtype : index
 %u_len = config.get @clef.u_len : index
 %u_dtype = config.get @clef.u_dtype : index
 %us_len = config.get @clef.us_len : index
 %us_dtype = config.get @clef.us_dtype : index
 %out_len = config.get @clef.out_len : index
 %out_dtype = config.get @clef.out_dtype : index
 %tokens = config.get @clef.tokens : index
 %topk = config.get @clef.topk : index
 %k = config.get @clef.k : index
 %n = config.get @clef.n : index
 %stride = config.get @clef.stride : index
 %input_routed = config.get @clef.input_routed : index
 %wg = kernel.workgroup.id<x> : index
 %subgroup = kernel.subgroup.id : index
 %lane = kernel.subgroup.lane.id : index
 %wgbase = index.mul %wg, %c2 : index
 %wave0 = index.add %wgbase, %subgroup : index
 %c15 = index.constant 15 : index
 %rounded = index.add %tokens, %c15 : index
 %tiles = index.div %rounded, %c16 : index
 %rowtile = index.rem %wave0, %tiles : index
 %wave = index.div %wave0, %tiles : index
 %mbase = index.mul %rowtile, %c16 : index
 %ntiles = index.div %n, %c32 : index
 %expert = index.div %wave, %ntiles : index
 %ntile = index.rem %wave, %ntiles : index
 %nbase = index.mul %ntile, %c32 : index
 %estride = index.add %tokens, %c1 : index
 %ebase = index.mul %expert, %estride : index
 %countf = template.apply<@clef.load>(%routes_dtype, %routes_buffer, %routes_len, %ebase) : (index, buffer, index, index) -> (f32)
 %counti0 = scalar.fptosi %countf : f32 to i32
 %counti = kernel.subgroup.broadcast.first %counti0 : i32
 %count0 = index.cast %counti : i32 to index
 %count = index.assume %count0 [range(%count0, 0, 2048)] : index
 %lane16 = index.rem %lane, %c16 : index
 %expertrow = index.mul %expert, %n : index
 %wrowbase = index.add %expertrow, %nbase : index
 %wrow = index.add %wrowbase, %lane16 : index
 %routed = index.cmp ne, %input_routed, %c0 : index
 %lds_bytes = index.constant 4096 : offset
 %wave_bytes = index.constant 2048 : offset
 %lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
 %wave_offset = index.scale %subgroup, %wave_bytes : index, offset -> offset
 %result = buffer.view %lds[%wave_offset] : buffer -> view<16x16xi32>
 %result_bytes = index.constant 1024 : offset
 %up_offset = index.add %wave_offset, %result_bytes : offset
 %up_result = buffer.view %lds[%up_offset] : buffer -> view<16x16xi32>
 %x_global = buffer.assume.memory_space<global> %x_buffer : buffer
 %xv = buffer.view %x_global[%offset] : buffer -> view<[%x_len]xi32>
 %w_global = buffer.assume.memory_space<global> %w_buffer : buffer
 %wv = buffer.view %w_global[%offset] : buffer -> view<[%w_len]xi32>
 %u_global = buffer.assume.memory_space<global> %u_buffer : buffer
 %uv = buffer.view %u_global[%offset] : buffer -> view<[%u_len]xi32>
 %init0 = vector.constant 0 : vector<8xi32>
 %init = vector.fragment<init> %init0 shape [%c16, %c16] : vector<8xi32>
 %schema = encoding.define #encoding.operand<element_format=i4, payload_elements=16, payload_registers=2> : encoding<schema>
 %active = index.cmp ult, %mbase, %count : index
 scf.if %active {
  %mr = index.add %mbase, %lane16 : index
  %ok = index.cmp ult, %mr, %count : index
  %safe = scf.select %ok, %mr, %c0 : index
  %slot0 = index.add %ebase, %safe : index
  %slot = index.add %slot0, %c1 : index
  %rf = template.apply<@clef.load>(%routes_dtype, %routes_buffer, %routes_len, %slot) : (index, buffer, index, index) -> (f32)
  %ri = scalar.fptosi %rf : f32 to i32
  %route0 = index.cast %ri : i32 to index
  %route = index.assume %route0 [range(%route0, 0, 16383)] : index
  %token = index.div %route, %topk : index
  %xr = scf.select %routed, %route, %token : index
  %xbase0 = index.mul %xr, %stride : index
  %xbase = index.div %xbase0, %c8 : index
  %acc0, %acc1, %acc2, %acc3 = scf.for %kk = [%c0 to %k step %c256](%a0 = %init : vector<8xi32>, %a1 = %init : vector<8xi32>, %a2 = %init : vector<8xi32>, %a3 = %init : vector<8xi32>) -> (vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>) {
   %xk = index.div %kk, %c8 : index
   %blocks = index.div %k, %c256 : index
   %blockk = index.div %kk, %c256 : index
   %kw = index.rem %xk, %c32 : index
   %xa0 = index.add %xbase, %xk : index
   %xlimit = index.constant 32 : index
   %xmax = index.sub %x_len, %xlimit : index
   %xa = index.assume %xa0 [range(%xa0, 0, 4294967294), le(%xa0, %xmax), multiple_of(%xa0, 16)] : index
   %aa = vector.load %xv[%xa] : view<[%x_len]xi32> -> vector<32xi32>
   %nc0 = index.constant 0 : index
   %wr0 = index.add %wrow, %nc0 : index
   %wn0 = index.div %wr0, %c128 : index
   %wb00 = index.mul %wn0, %blocks : index
   %wb10 = index.add %wb00, %blockk : index
   %wb20 = index.mul %wb10, %c128 : index
   %wl0 = index.rem %wr0, %c128 : index
   %wb30 = index.add %wb20, %wl0 : index
   %wb40 = index.mul %wb30, %c32 : index
   %wa00 = index.add %wb40, %kw : index
   %wmax0 = index.sub %w_len, %xlimit : index
   %wa0 = index.assume %wa00 [range(%wa00, 0, 4294967294), le(%wa00, %wmax0), multiple_of(%wa00, 32)] : index
   %bb0 = vector.load %wv[%wa0] : view<[%w_len]xi32> -> vector<32xi32>
   %nc1 = index.constant 16 : index
   %wr1 = index.add %wrow, %nc1 : index
   %wn1 = index.div %wr1, %c128 : index
   %wb01 = index.mul %wn1, %blocks : index
   %wb11 = index.add %wb01, %blockk : index
   %wb21 = index.mul %wb11, %c128 : index
   %wl1 = index.rem %wr1, %c128 : index
   %wb31 = index.add %wb21, %wl1 : index
   %wb41 = index.mul %wb31, %c32 : index
   %wa01 = index.add %wb41, %kw : index
   %wmax1 = index.sub %w_len, %xlimit : index
   %wa1 = index.assume %wa01 [range(%wa01, 0, 4294967294), le(%wa01, %wmax1), multiple_of(%wa01, 32)] : index
   %bb1 = vector.load %wv[%wa1] : view<[%w_len]xi32> -> vector<32xi32>
   %nc2 = index.constant 0 : index
   %wr2 = index.add %wrow, %nc2 : index
   %wn2 = index.div %wr2, %c128 : index
   %wb02 = index.mul %wn2, %blocks : index
   %wb12 = index.add %wb02, %blockk : index
   %wb22 = index.mul %wb12, %c128 : index
   %wl2 = index.rem %wr2, %c128 : index
   %wb32 = index.add %wb22, %wl2 : index
   %wb42 = index.mul %wb32, %c32 : index
   %wa02 = index.add %wb42, %kw : index
   %wmax2 = index.sub %u_len, %xlimit : index
   %wa2 = index.assume %wa02 [range(%wa02, 0, 4294967294), le(%wa02, %wmax2), multiple_of(%wa02, 32)] : index
   %bb2 = vector.load %uv[%wa2] : view<[%u_len]xi32> -> vector<32xi32>
   %nc3 = index.constant 16 : index
   %wr3 = index.add %wrow, %nc3 : index
   %wn3 = index.div %wr3, %c128 : index
   %wb03 = index.mul %wn3, %blocks : index
   %wb13 = index.add %wb03, %blockk : index
   %wb23 = index.mul %wb13, %c128 : index
   %wl3 = index.rem %wr3, %c128 : index
   %wb33 = index.add %wb23, %wl3 : index
   %wb43 = index.mul %wb33, %c32 : index
   %wa03 = index.add %wb43, %kw : index
   %wmax3 = index.sub %u_len, %xlimit : index
   %wa3 = index.assume %wa03 [range(%wa03, 0, 4294967294), le(%wa03, %wmax3), multiple_of(%wa03, 32)] : index
   %bb3 = vector.load %uv[%wa3] : view<[%u_len]xi32> -> vector<32xi32>
   %l_p0_v = vector.slice %aa[0] : vector<32xi32> -> vector<2xi32>
   %l_p0 = vector.fragment<lhs> %l_p0_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r0_p0_v = vector.slice %bb0[0] : vector<32xi32> -> vector<2xi32>
   %r0_p0 = vector.fragment<rhs> %r0_p0_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r1_p0_v = vector.slice %bb1[0] : vector<32xi32> -> vector<2xi32>
   %r1_p0 = vector.fragment<rhs> %r1_p0_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r2_p0_v = vector.slice %bb2[0] : vector<32xi32> -> vector<2xi32>
   %r2_p0 = vector.fragment<rhs> %r2_p0_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r3_p0_v = vector.slice %bb3[0] : vector<32xi32> -> vector<2xi32>
   %r3_p0 = vector.fragment<rhs> %r3_p0_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %v0_p0 = vector.mma %l_p0, %r0_p0, %a0 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v1_p0 = vector.mma %l_p0, %r1_p0, %a1 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v2_p0 = vector.mma %l_p0, %r2_p0, %a2 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v3_p0 = vector.mma %l_p0, %r3_p0, %a3 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %l_p1_v = vector.slice %aa[2] : vector<32xi32> -> vector<2xi32>
   %l_p1 = vector.fragment<lhs> %l_p1_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r0_p1_v = vector.slice %bb0[2] : vector<32xi32> -> vector<2xi32>
   %r0_p1 = vector.fragment<rhs> %r0_p1_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r1_p1_v = vector.slice %bb1[2] : vector<32xi32> -> vector<2xi32>
   %r1_p1 = vector.fragment<rhs> %r1_p1_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r2_p1_v = vector.slice %bb2[2] : vector<32xi32> -> vector<2xi32>
   %r2_p1 = vector.fragment<rhs> %r2_p1_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r3_p1_v = vector.slice %bb3[2] : vector<32xi32> -> vector<2xi32>
   %r3_p1 = vector.fragment<rhs> %r3_p1_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %v0_p1 = vector.mma %l_p1, %r0_p1, %v0_p0 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v1_p1 = vector.mma %l_p1, %r1_p1, %v1_p0 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v2_p1 = vector.mma %l_p1, %r2_p1, %v2_p0 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v3_p1 = vector.mma %l_p1, %r3_p1, %v3_p0 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %l_p2_v = vector.slice %aa[4] : vector<32xi32> -> vector<2xi32>
   %l_p2 = vector.fragment<lhs> %l_p2_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r0_p2_v = vector.slice %bb0[4] : vector<32xi32> -> vector<2xi32>
   %r0_p2 = vector.fragment<rhs> %r0_p2_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r1_p2_v = vector.slice %bb1[4] : vector<32xi32> -> vector<2xi32>
   %r1_p2 = vector.fragment<rhs> %r1_p2_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r2_p2_v = vector.slice %bb2[4] : vector<32xi32> -> vector<2xi32>
   %r2_p2 = vector.fragment<rhs> %r2_p2_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r3_p2_v = vector.slice %bb3[4] : vector<32xi32> -> vector<2xi32>
   %r3_p2 = vector.fragment<rhs> %r3_p2_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %v0_p2 = vector.mma %l_p2, %r0_p2, %v0_p1 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v1_p2 = vector.mma %l_p2, %r1_p2, %v1_p1 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v2_p2 = vector.mma %l_p2, %r2_p2, %v2_p1 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v3_p2 = vector.mma %l_p2, %r3_p2, %v3_p1 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %l_p3_v = vector.slice %aa[6] : vector<32xi32> -> vector<2xi32>
   %l_p3 = vector.fragment<lhs> %l_p3_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r0_p3_v = vector.slice %bb0[6] : vector<32xi32> -> vector<2xi32>
   %r0_p3 = vector.fragment<rhs> %r0_p3_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r1_p3_v = vector.slice %bb1[6] : vector<32xi32> -> vector<2xi32>
   %r1_p3 = vector.fragment<rhs> %r1_p3_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r2_p3_v = vector.slice %bb2[6] : vector<32xi32> -> vector<2xi32>
   %r2_p3 = vector.fragment<rhs> %r2_p3_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r3_p3_v = vector.slice %bb3[6] : vector<32xi32> -> vector<2xi32>
   %r3_p3 = vector.fragment<rhs> %r3_p3_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %v0_p3 = vector.mma %l_p3, %r0_p3, %v0_p2 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v1_p3 = vector.mma %l_p3, %r1_p3, %v1_p2 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v2_p3 = vector.mma %l_p3, %r2_p3, %v2_p2 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v3_p3 = vector.mma %l_p3, %r3_p3, %v3_p2 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %l_p4_v = vector.slice %aa[8] : vector<32xi32> -> vector<2xi32>
   %l_p4 = vector.fragment<lhs> %l_p4_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r0_p4_v = vector.slice %bb0[8] : vector<32xi32> -> vector<2xi32>
   %r0_p4 = vector.fragment<rhs> %r0_p4_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r1_p4_v = vector.slice %bb1[8] : vector<32xi32> -> vector<2xi32>
   %r1_p4 = vector.fragment<rhs> %r1_p4_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r2_p4_v = vector.slice %bb2[8] : vector<32xi32> -> vector<2xi32>
   %r2_p4 = vector.fragment<rhs> %r2_p4_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r3_p4_v = vector.slice %bb3[8] : vector<32xi32> -> vector<2xi32>
   %r3_p4 = vector.fragment<rhs> %r3_p4_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %v0_p4 = vector.mma %l_p4, %r0_p4, %v0_p3 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v1_p4 = vector.mma %l_p4, %r1_p4, %v1_p3 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v2_p4 = vector.mma %l_p4, %r2_p4, %v2_p3 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %v3_p4 = vector.mma %l_p4, %r3_p4, %v3_p3 : vector<2xi32>, vector<2xi32>, vector<8xi32>
   %l_p5_v = vector.slice %aa[10] : vector<32xi32> -> vector<2xi32>
   %l_p5 = vector.fragment<lhs> %l_p5_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r0_p5_v = vector.slice %bb0[10] : vector<32xi32> -> vector<2xi32>
   %r0_p5 = vector.fragment<rhs> %r0_p5_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r1_p5_v = vector.slice %bb1[10] : vector<32xi32> -> vector<2xi32>
   %r1_p5 = vector.fragment<rhs> %r1_p5_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
   %r2_p5_v = vector.slice %bb2[10] : vector<32xi32> -> vector<2xi32>
   %r2_p5 = vector.fragment<rhs> %r2_p5_v shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<2xi32>
