  %packed_per_word = index.constant 8 : index
  %rows_bound = index.constant 16777216 : index
  %fuse_residual = scalar.constant true : i1
  template.apply<@h3.packed_m128>(%m_size, %a, %w, %scale, %a_scale, %residual, %fuse_residual, %c, %cfg_k_size, %cfg_n_size, %cfg_k_stride, %cfg_m_group, %registers, %k_step, %packed_per_word, %rows_bound) : (index, buffer, buffer, buffer, buffer, buffer, i1, buffer, index, index, index, index, index, index, index, index)
  kernel.return
