// M128/N128/K256 INT4 tile for requests that avoid substantial row padding.
// Adapted from h3-hrx kernels/gemm_packed_256.loom (Apache-2.0),
// revision 95ed12f43bd3e596cbfad175c22de9560447e9e5.
// Same packed-operand binding/configuration contract and BF16 output rounding.
template.decl @h3.packed_schema(%registers: index) -> (encoding<schema>)

template.def<@h3.packed_schema> @h3_packed_i4(%registers: index) -> (encoding<schema>) where [eq(%registers, 2)] {
  %schema = encoding.define #encoding.operand<element_format=i4, payload_elements=16, payload_registers=2> : encoding<schema>
  template.return %schema : encoding<schema>
}



template.decl @h3.packed_m128(%m_size: index, %a: buffer, %w: buffer, %scale: buffer, %a_scale: buffer, %residual: buffer, %fuse_residual: i1, %c: buffer, %cfg_k_size: index, %cfg_n_size: index, %cfg_k_stride: index, %cfg_m_group: index, %registers: index, %k_step: index, %packed_per_word: index, %rows_bound: index)

template.def<@h3.packed_m128> @h3_packed_m128(%m_size: index, %a: buffer, %w: buffer, %scale: buffer, %a_scale: buffer, %residual: buffer, %fuse_residual: i1, %c: buffer, %cfg_k_size: index, %cfg_n_size: index, %cfg_k_stride: index, %cfg_m_group: index, %registers: index, %k_step: index, %packed_per_word: index, %rows_bound: index) {
  %k_size = index.assume %cfg_k_size [range(%cfg_k_size, 64, 65536), mul(%cfg_k_size, 64)] : index
  // Pad 1024-aligned operand rows to avoid cache-set conflicts.
  %k_stride = index.assume %cfg_k_stride [range(%cfg_k_stride, 64, 65536), mul(%cfg_k_stride, 64)] : index
  %n_size = index.assume %cfg_n_size [range(%cfg_n_size, 128, 65536), mul(%cfg_n_size, 128)] : index

  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c96 = index.constant 96 : index
  %c128 = index.constant 128 : index
  %cf1 = index.constant 1 : index
  %cf2 = index.constant 2 : index
  %cf3 = index.constant 3 : index
  %cf4 = index.constant 4 : index
  %cf5 = index.constant 5 : index
  %cf6 = index.constant 6 : index
  %cf7 = index.constant 7 : index
  %c0_offset = index.constant 0 : offset
  %lds_bytes = index.constant 36864 : offset
  %w_stage_offset = index.constant 18432 : offset
  %wave_result_bytes = index.constant 2048 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %zero_i32x8 = vector.constant 0 : vector<8xi32>
  %i4_schema = template.apply<@h3.packed_schema>(%registers) : (index) -> (encoding<schema>)

  %workitem = kernel.workitem.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index
  %lane16 = index.rem %lane, %c16 : index
  %m_bounded = index.assume %m_size [range(%m_size, 1, 16777216), le(%m_size, %rows_bound)] : index
  %wg_x = kernel.workgroup.id<x> : index
  %wg_y = kernel.workgroup.id<y> : index
  %c_n_tiles = index.div %n_size, %c128 : index
  %linear0 = index.mul %wg_y, %c_n_tiles : index
  %linear = index.add %linear0, %wg_x : index
  %group_span = index.mul %c_n_tiles, %cfg_m_group : index
  %group = index.div %linear, %group_span : index
  %in_group = index.rem %linear, %group_span : index
  %group_m = index.mul %group, %cfg_m_group : index
  %m_in_group = index.rem %in_group, %cfg_m_group : index
  %tile_m_id = index.add %group_m, %m_in_group : index
  %tile_n_id0 = index.div %in_group, %cfg_m_group : index
  %tile_n_id = index.assume %tile_n_id0 [lt(%tile_n_id0, %c_n_tiles)] : index

  // Wave grid 4 (m) x 2 (n): rows wave_row..+32, columns wave_col..+64 of the tile.
  %wave_m = index.div %subgroup, %c2 : index
  %wave_n = index.rem %subgroup, %c2 : index
  %wave_row = index.mul %wave_m, %c32 : index
  %wave_col = index.mul %wave_n, %c64 : index
  %base_m = index.mul %tile_m_id, %c128 : index
  %base_n = index.mul %tile_n_id, %c128 : index
  // Raster groups can include entirely padded row tiles. This branch is workgroup-uniform.
  %has_rows = index.cmp ult, %base_m, %m_bounded : index
  scf.if %has_rows {
    %k_quads = index.div %k_stride, %packed_per_word : index

    %a_global = buffer.assume.memory_space<global> %a : buffer
    %w_global = buffer.assume.memory_space<global> %w : buffer
    %scale_global = buffer.assume.memory_space<global> %scale : buffer
    %c_global = buffer.assume.memory_space<global> %c : buffer
    %a_view = buffer.view %a_global[%c0_offset] : buffer -> view<[%m_bounded]x[%k_quads]xi32>
    %w_view = buffer.view %w_global[%c0_offset] : buffer -> view<[%n_size]x[%k_quads]xi32>
    %scale_view = buffer.view %scale_global[%c0_offset] : buffer -> view<[%n_size]xf32>
    %a_scale_global = buffer.assume.memory_space<global> %a_scale : buffer
    %a_scale_view = buffer.view %a_scale_global[%c0_offset] : buffer -> view<[%m_bounded]xf32>
    %c_view = buffer.view %c_global[%c0_offset] : buffer -> view<[%m_bounded]x[%n_size]xbf16>

    %lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
    %a_stage = buffer.view %lds[%c0_offset] : buffer -> view<128x36xi32>
    %w_stage = buffer.view %lds[%w_stage_offset] : buffer -> view<128x36xi32>
    %wave_result_offset = index.scale %subgroup, %wave_result_bytes : index, offset -> offset
    %result_view = buffer.view %lds[%wave_result_offset] : buffer -> view<16x16xi32>

    // Eight 16-byte packets per row cover K128 for int8.
    %st_sub = index.rem %workitem, %c8 : index
    %st_quad = index.mul %st_sub, %c4 : index
    %st_row_base = index.div %workitem, %c8 : index
    %k_quad_limit = index.sub %k_quads, %c4 : index
    %st_arow0 = index.add %st_row_base, %c0 : index
    %a_m0 = index.add %base_m, %st_arow0 : index
    %a_ok0 = index.cmp ult, %a_m0, %m_bounded : index
    %a_safe0 = scf.select %a_ok0, %a_m0, %c0 : index
    %a_row0 = index.assume %a_safe0 [lt(%a_safe0, %m_bounded)] : index
    %st_wrow0 = index.add %st_row_base, %c0 : index
    %w_n0 = index.add %base_n, %st_wrow0 : index
    %w_row0 = index.assume %w_n0 [lt(%w_n0, %n_size)] : index
    %st_arow1 = index.add %st_row_base, %c32 : index
    %a_m1 = index.add %base_m, %st_arow1 : index
    %a_ok1 = index.cmp ult, %a_m1, %m_bounded : index
    %a_safe1 = scf.select %a_ok1, %a_m1, %c0 : index
    %a_row1 = index.assume %a_safe1 [lt(%a_safe1, %m_bounded)] : index
    %st_wrow1 = index.add %st_row_base, %c32 : index
    %w_n1 = index.add %base_n, %st_wrow1 : index
    %w_row1 = index.assume %w_n1 [lt(%w_n1, %n_size)] : index
    %st_arow2 = index.add %st_row_base, %c64 : index
    %a_m2 = index.add %base_m, %st_arow2 : index
    %a_ok2 = index.cmp ult, %a_m2, %m_bounded : index
    %a_safe2 = scf.select %a_ok2, %a_m2, %c0 : index
    %a_row2 = index.assume %a_safe2 [lt(%a_safe2, %m_bounded)] : index
    %st_wrow2 = index.add %st_row_base, %c64 : index
    %w_n2 = index.add %base_n, %st_wrow2 : index
    %w_row2 = index.assume %w_n2 [lt(%w_n2, %n_size)] : index
    %st_arow3 = index.add %st_row_base, %c96 : index
    %a_m3 = index.add %base_m, %st_arow3 : index
    %a_ok3 = index.cmp ult, %a_m3, %m_bounded : index
    %a_safe3 = scf.select %a_ok3, %a_m3, %c0 : index
    %a_row3 = index.assume %a_safe3 [lt(%a_safe3, %m_bounded)] : index
    %st_wrow3 = index.add %st_row_base, %c96 : index
    %w_n3 = index.add %base_n, %st_wrow3 : index
    %w_row3 = index.assume %w_n3 [lt(%w_n3, %n_size)] : index

    // Operand rows this lane reads: A rows wave_row + 16i + lane16, W rows wave_col + 16j + lane16.
    %fa0 = index.add %wave_row, %lane16 : index
    %fa1 = index.add %fa0, %c16 : index
    %fb0 = index.add %wave_col, %lane16 : index
    %fb1 = index.add %fb0, %c16 : index
    %fb2 = index.add %fb0, %c32 : index
    %fb3 = index.add %fb0, %c48 : index

    %acc_init = vector.fragment<init> %zero_i32x8 shape [%m, %n] : vector<8xi32>

    // Gather of the first k step into registers.
    %kq_first = index.assume %st_quad [le(%st_quad, %k_quad_limit), mul(%st_quad, 4)] : index
    %ga0 = vector.load %a_view[%a_row0, %kq_first] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
    %ga1 = vector.load %a_view[%a_row1, %kq_first] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
    %ga2 = vector.load %a_view[%a_row2, %kq_first] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
    %ga3 = vector.load %a_view[%a_row3, %kq_first] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
    %gw0 = vector.load %w_view[%w_row0, %kq_first] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
    %gw1 = vector.load %w_view[%w_row1, %kq_first] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
    %gw2 = vector.load %w_view[%w_row2, %kq_first] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
    %gw3 = vector.load %w_view[%w_row3, %kq_first] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>

    %acc00, %acc01, %acc02, %acc03, %acc10, %acc11, %acc12, %acc13, %a_last0, %a_last1, %w_last0, %w_last1, %a_last2, %a_last3, %w_last2, %w_last3 = scf.for %k_base = [%c0 to %k_size step %k_step](%r00 = %acc_init : vector<8xi32>, %r01 = %acc_init : vector<8xi32>, %r02 = %acc_init : vector<8xi32>, %r03 = %acc_init : vector<8xi32>, %r10 = %acc_init : vector<8xi32>, %r11 = %acc_init : vector<8xi32>, %r12 = %acc_init : vector<8xi32>, %r13 = %acc_init : vector<8xi32>, %ca0 = %ga0 : vector<4xi32>, %ca1 = %ga1 : vector<4xi32>, %cw0 = %gw0 : vector<4xi32>, %cw1 = %gw1 : vector<4xi32>, %ca2 = %ga2 : vector<4xi32>, %ca3 = %ga3 : vector<4xi32>, %cw2 = %gw2 : vector<4xi32>, %cw3 = %gw3 : vector<4xi32>) -> (vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>) {
      // Stage what we were handed.
      vector.store %ca0, %a_stage[%st_arow0, %st_quad] : vector<4xi32>, view<128x36xi32>
      vector.store %ca1, %a_stage[%st_arow1, %st_quad] : vector<4xi32>, view<128x36xi32>
      vector.store %ca2, %a_stage[%st_arow2, %st_quad] : vector<4xi32>, view<128x36xi32>
      vector.store %ca3, %a_stage[%st_arow3, %st_quad] : vector<4xi32>, view<128x36xi32>
      vector.store %cw0, %w_stage[%st_wrow0, %st_quad] : vector<4xi32>, view<128x36xi32>
      vector.store %cw1, %w_stage[%st_wrow1, %st_quad] : vector<4xi32>, view<128x36xi32>
      vector.store %cw2, %w_stage[%st_wrow2, %st_quad] : vector<4xi32>, view<128x36xi32>
      vector.store %cw3, %w_stage[%st_wrow3, %st_quad] : vector<4xi32>, view<128x36xi32>
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

      // Prefetch the next step while the WMMAs run on this one.
      %k_next = index.add %k_base, %k_step : index
      %in_k = index.cmp ult, %k_next, %k_size : index
      %kq_next0 = index.div %k_next, %packed_per_word : index
      %kq_slot = index.add %kq_next0, %st_quad : index
      %kq_safe = scf.select %in_k, %kq_slot, %st_quad : index
      %kq_next = index.assume %kq_safe [le(%kq_safe, %k_quad_limit), mul(%kq_safe, 4)] : index
      %na0 = vector.load %a_view[%a_row0, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %na1 = vector.load %a_view[%a_row1, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %na2 = vector.load %a_view[%a_row2, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %na3 = vector.load %a_view[%a_row3, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %nw0 = vector.load %w_view[%w_row0, %kq_next] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
      %nw1 = vector.load %w_view[%w_row1, %kq_next] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
      %nw2 = vector.load %w_view[%w_row2, %kq_next] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
      %nw3 = vector.load %w_view[%w_row3, %kq_next] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>

      // Full unrolling preserves the source order of each staged substep.
      %substeps = index.div %c32, %registers : index
      %o00_end, %o01_end, %o02_end, %o03_end, %o10_end, %o11_end, %o12_end, %o13_end = scf.for %sub = [%c0 to %substeps step %c1](%carry00 = %r00 : vector<8xi32>, %carry01 = %r01 : vector<8xi32>, %carry02 = %r02 : vector<8xi32>, %carry03 = %r03 : vector<8xi32>, %carry10 = %r10 : vector<8xi32>, %carry11 = %r11 : vector<8xi32>, %carry12 = %r12 : vector<8xi32>, %carry13 = %r13 : vector<8xi32>) -> (vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>) unroll {
        %sub_column = index.mul %sub, %registers : index
        %u_da0 = vector.load %a_stage[%fa0, %sub_column] : view<128x36xi32> -> vector<[%registers]xi32>
        %u_da1 = vector.load %a_stage[%fa1, %sub_column] : view<128x36xi32> -> vector<[%registers]xi32>
        %u_db0 = vector.load %w_stage[%fb0, %sub_column] : view<128x36xi32> -> vector<[%registers]xi32>
        %u_db1 = vector.load %w_stage[%fb1, %sub_column] : view<128x36xi32> -> vector<[%registers]xi32>
        %u_db2 = vector.load %w_stage[%fb2, %sub_column] : view<128x36xi32> -> vector<[%registers]xi32>
        %u_db3 = vector.load %w_stage[%fb3, %sub_column] : view<128x36xi32> -> vector<[%registers]xi32>
        %u_la0 = vector.fragment<lhs> %u_da0 shape [%m, %k] using {schema = %i4_schema : encoding<schema>} : vector<[%registers]xi32>
        %u_la1 = vector.fragment<lhs> %u_da1 shape [%m, %k] using {schema = %i4_schema : encoding<schema>} : vector<[%registers]xi32>
        %u_rb0 = vector.fragment<rhs> %u_db0 shape [%k, %n] using {schema = %i4_schema : encoding<schema>} : vector<[%registers]xi32>
        %u_rb1 = vector.fragment<rhs> %u_db1 shape [%k, %n] using {schema = %i4_schema : encoding<schema>} : vector<[%registers]xi32>
        %u_rb2 = vector.fragment<rhs> %u_db2 shape [%k, %n] using {schema = %i4_schema : encoding<schema>} : vector<[%registers]xi32>
        %u_rb3 = vector.fragment<rhs> %u_db3 shape [%k, %n] using {schema = %i4_schema : encoding<schema>} : vector<[%registers]xi32>
        %u_o00 = vector.mma %u_la0, %u_rb0, %carry00 : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
        %u_o01 = vector.mma %u_la0, %u_rb1, %carry01 : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
        %u_o02 = vector.mma %u_la0, %u_rb2, %carry02 : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
        %u_o03 = vector.mma %u_la0, %u_rb3, %carry03 : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
        %u_o10 = vector.mma %u_la1, %u_rb0, %carry10 : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
        %u_o11 = vector.mma %u_la1, %u_rb1, %carry11 : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
        %u_o12 = vector.mma %u_la1, %u_rb2, %carry12 : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
        %u_o13 = vector.mma %u_la1, %u_rb3, %carry13 : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
        scf.yield %u_o00, %u_o01, %u_o02, %u_o03, %u_o10, %u_o11, %u_o12, %u_o13 : vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      scf.yield %o00_end, %o01_end, %o02_end, %o03_end, %o10_end, %o11_end, %o12_end, %o13_end, %na0, %na1, %nw0, %nw1, %na2, %na3, %nw2, %nw3 : vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>
    }

    // Publish through LDS. Each lane takes two vector4 slices of each staged 16x16 tile.
    %publish_row0 = index.div %lane, %c4 : index
    %publish_col_group = index.rem %lane, %c4 : index
    %publish_col = index.mul %publish_col_group, %c4 : index
    %zero_f32 = scalar.constant 0.0 : f32
    %zero4 = vector.splat %zero_f32 : vector<4xf32>
    %bf16_max4 = vector.constant 3.3895313892515355e38 : vector<4xf32>
    %bf16_min4 = vector.constant -3.3895313892515355e38 : vector<4xf32>
    scf.for %step = [%c0 to %c8 step %c1] {
      %fi = index.div %step, %c4 : index
      %fj = index.rem %step, %c4 : index
      %g_is1 = index.cmp eq, %step, %cf1 : index
      %g_p1 = scf.select %g_is1, %acc01, %acc00 : vector<8xi32>
      %g_is2 = index.cmp eq, %step, %cf2 : index
      %g_p2 = scf.select %g_is2, %acc02, %g_p1 : vector<8xi32>
      %g_is3 = index.cmp eq, %step, %cf3 : index
      %g_p3 = scf.select %g_is3, %acc03, %g_p2 : vector<8xi32>
      %g_is4 = index.cmp eq, %step, %cf4 : index
      %g_p4 = scf.select %g_is4, %acc10, %g_p3 : vector<8xi32>
      %g_is5 = index.cmp eq, %step, %cf5 : index
      %g_p5 = scf.select %g_is5, %acc11, %g_p4 : vector<8xi32>
      %g_is6 = index.cmp eq, %step, %cf6 : index
      %g_p6 = scf.select %g_is6, %acc12, %g_p5 : vector<8xi32>
      %g_is7 = index.cmp eq, %step, %cf7 : index
      %g_p7 = scf.select %g_is7, %acc13, %g_p6 : vector<8xi32>
      vector.fragment.store<result> %g_p7, %result_view[%c0, %c0] shape [%m, %n] : vector<8xi32>, view<16x16xi32>
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
      %frag_row_offset = index.mul %fi, %c16 : index
      %frag_col_offset = index.mul %fj, %c16 : index
      %tile_col = index.add %wave_col, %frag_col_offset : index
      %out_col_local = index.add %tile_col, %publish_col : index
      %out_col = index.add %base_n, %out_col_local : index
      %scale_values = vector.load %scale_view[%out_col] : view<[%n_size]xf32> -> vector<4xf32>
      scf.for %half = [%c0 to %c2 step %c1] {
        %row_offset = index.mul %half, %c8 : index
        %publish_row = index.add %publish_row0, %row_offset : index
        %values = vector.load %result_view[%publish_row, %publish_col] : view<16x16xi32> -> vector<4xi32>
        %values_f32 = vector.sitofp %values : vector<4xi32> to vector<4xf32>
        %scaled0 = vector.mulf %values_f32, %scale_values : vector<4xf32>
        %row_in_wave = index.add %frag_row_offset, %publish_row : index
        %row_local = index.add %wave_row, %row_in_wave : index
        %out_row = index.add %base_m, %row_local : index
        %writes = index.cmp ult, %out_row, %m_bounded : index
        scf.if %writes {
          %bounded = index.assume %out_row [lt(%out_row, %m_bounded)] : index
          %a_scale_value = view.load %a_scale_view[%bounded] : view<[%m_bounded]xf32> -> f32
          %a_scale_vector = vector.splat %a_scale_value : vector<4xf32>
          %scaled1 = vector.mulf %scaled0, %a_scale_vector : vector<4xf32>
          %scaled = vector.addf %scaled1, %zero4 : vector<4xf32>
          %sat0 = vector.minnumf %scaled, %bf16_max4 : vector<4xf32>
          %sat = vector.maxnumf %sat0, %bf16_min4 : vector<4xf32>
          // Clamp finite values only; invalid arithmetic must remain observable.
          %range_inf = vector.constant inf : vector<4xf32>
          %range_abs = vector.absf %scaled : vector<4xf32>
          %range_finite = vector.cmpf olt, %range_abs, %range_inf : vector<4xf32> -> vector<4xi1>
          %range_checked = vector.select %range_finite, %sat, %scaled : vector<4xf32>
          %narrow = vector.fptrunc %range_checked : vector<4xf32> to vector<4xbf16>
          %with_residual = scf.if %fuse_residual -> (vector<4xbf16>) {
            // Match a separate BF16 store/load before the residual addition.
            %residual_global = buffer.assume.memory_space<global> %residual : buffer
            %residual_view = buffer.view %residual_global[%c0_offset] : buffer -> view<[%m_bounded]x[%n_size]xbf16>
            %residual_bf16 = vector.load %residual_view[%bounded, %out_col] : view<[%m_bounded]x[%n_size]xbf16> -> vector<4xbf16>
            %residual_f32 = vector.extf %residual_bf16 : vector<4xbf16> to vector<4xf32>
            %rounded = vector.extf %narrow : vector<4xbf16> to vector<4xf32>
            %residual_sum = vector.addf %residual_f32, %rounded : vector<4xf32>
            %residual_out = vector.fptrunc %residual_sum : vector<4xf32> to vector<4xbf16>
            scf.yield %residual_out : vector<4xbf16>
          } else { scf.yield %narrow : vector<4xbf16> }
          vector.store %with_residual, %c_view[%bounded, %out_col] : vector<4xbf16>, view<[%m_bounded]x[%n_size]xbf16>
        }
      }
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
    }
  }
  template.return
}

amdgpu.target<gfx11-generic> @h3_gemm_i4_256_gfx11 {subgroup_size = 32}

config.decl @h3.gemm_i4_256.k_size : %value: index where [range(%value, 256, 65536), mul(%value, 256)]

config.decl @h3.gemm_i4_256.n_size : %value: index where [range(%value, 128, 65536), mul(%value, 128)]

config.decl @h3.gemm_i4_256.k_stride : %value: index where [range(%value, 128, 65536), mul(%value, 128)]

config.decl @h3.gemm_i4_256.m_group : %value: index where [range(%value, 1, 4)]

kernel.def target(@h3_gemm_i4_256_gfx11) export("h3_gemm_i4_256") @h3_gemm_i4_256(%m_size: index) {
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c128 = index.constant 128 : index
  %c255 = index.constant 127 : index
  %c256 = index.constant 256 : index
  %n_size0 = config.get @h3.gemm_i4_256.n_size : index
  %m_rounded = index.add %m_size, %c255 : index
  %m_tiles = index.div %m_rounded, %c128 : index
  %m_group = config.get @h3.gemm_i4_256.m_group : index
  %m_group_less = index.sub %m_group, %c1 : index
  %m_tiles3 = index.add %m_tiles, %m_group_less : index
  %m_groups = index.div %m_tiles3, %m_group : index
  %m_tiles_padded = index.mul %m_groups, %m_group : index
  %n_tiles = index.div %n_size0, %c128 : index
  kernel.launch.config workgroups(%n_tiles, %m_tiles_padded, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%m_size: index, %a: buffer, %w: buffer, %scale: buffer, %a_scale: buffer, %c: buffer) {
  %cfg_k_size = config.get @h3.gemm_i4_256.k_size : index
  %cfg_n_size = config.get @h3.gemm_i4_256.n_size : index
  %cfg_k_stride = config.get @h3.gemm_i4_256.k_stride : index
  %cfg_m_group = config.get @h3.gemm_i4_256.m_group : index
  %registers = index.constant 2 : index
  %k_step = index.constant 256 : index
  %packed_per_word = index.constant 8 : index
  %rows_bound = index.constant 16777216 : index
  %fuse_residual = scalar.constant false : i1
  template.apply<@h3.packed_m128>(%m_size, %a, %w, %scale, %a_scale, %c, %fuse_residual, %c, %cfg_k_size, %cfg_n_size, %cfg_k_stride, %cfg_m_group, %registers, %k_step, %packed_per_word, %rows_bound) : (index, buffer, buffer, buffer, buffer, buffer, i1, buffer, index, index, index, index, index, index, index, index)
  kernel.return
}

// Optional residual uses the same tile and preserves both BF16 rounding boundaries.
kernel.def target(@h3_gemm_i4_256_gfx11) export("h3_gemm_i4_256_residual") @h3_gemm_i4_256_residual(%m_size: index) {
  %c1 = index.constant 1 : index
