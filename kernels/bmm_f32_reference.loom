// bmm_f32. Shapes and storage types are compiler specializations.
amdgpu.target<gfx11-generic> @clef_target {subgroup_size = 32}
config.decl @clef.work : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.groups : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.out_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.out_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.a_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.a_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.b_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.b_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.k : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.kn : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.mk : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.mn : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.n : %value: index where [range(%value, 0, 4294967295)]

kernel.def target(@clef_target) export("clef_op") @clef_op() {
 %one = index.constant 1 : index
 %threads = index.constant 64 : index
 %groups = config.get @clef.groups : index
 kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%a_buffer: buffer, %b_buffer: buffer, %out_buffer: buffer) {
 %zero = index.constant 0 : index
 %one = index.constant 1 : index
 %threads = index.constant 64 : index
 %offset = index.constant 0 : offset
 %fzero = scalar.constant 0.0 : f32
 %fone = scalar.constant 1.0 : f32
 %wg = kernel.workgroup.id<x> : index
 %lane = kernel.workitem.id<x> : index
 %base = index.mul %wg, %threads : index
 %id = index.add %base, %lane : index
 %count = config.get @clef.work : index
 %out_len = config.get @clef.out_len : index
 %out_dtype = config.get @clef.out_dtype : index
 %outv = buffer.view %out_buffer[%offset] : buffer -> view<[%out_len]xf32>
 %a_len = config.get @clef.a_len : index
 %a_dtype = config.get @clef.a_dtype : index
 %b_len = config.get @clef.b_len : index
 %b_dtype = config.get @clef.b_dtype : index
 %active = index.cmp ult, %id, %count : index
 scf.if %active {

%n = config.get @clef.n : index
%k = config.get @clef.k : index
%mn = config.get @clef.mn : index
%mk = config.get @clef.mk : index
%kn = config.get @clef.kn : index
%batch = index.div %id, %mn : index
%within = index.rem %id, %mn : index
%row = index.div %within, %n : index
%col = index.rem %within, %n : index
%ab0 = index.mul %batch, %mk : index
%ab1 = index.mul %row, %k : index
%ab = index.add %ab0, %ab1 : index
%bb0 = index.mul %batch, %kn : index
%bb = index.add %bb0, %col : index
%sum = scf.for %j = [%zero to %k step %one](%acc = %fzero : f32) -> (f32) {
 %ai = index.add %ab, %j : index
 %bj = index.mul %j, %n : index
 %bi = index.add %bb, %bj : index
 %a = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %ai) : (index, buffer, index, index) -> (f32)
%b = template.apply<@clef.load>(%b_dtype, %b_buffer, %b_len, %bi) : (index, buffer, index, index) -> (f32)

 %next = scalar.fmaf %a, %b, %acc : f32
 scf.yield %next : f32
}
template.apply<@clef.store>(%out_dtype, %out_buffer, %out_len, %id, %sum) : (index, buffer, index, index, f32) -> ()


 }
 kernel.return
}
