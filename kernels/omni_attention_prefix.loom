 vector.store %o5raw, %out[%orow5, %qcol5] : vector<16xbf16>, view<[%queries]x[%qw]xbf16>
}
%output6 = vector.divf %final6, %sumv : vector<8xf32>
%o6half = vector.fptrunc %output6 : vector<8xf32> to vector<8xbf16>
%o6words = vector.bitcast %o6half : vector<8xbf16> to vector<4xi32>
%o6partner, %o6valid = kernel.subgroup.shuffle<xor> %o6words, %i16, %i32 : vector<4xi32>, i32, i32
%o6even = scf.select %even, %o6words, %o6partner : vector<4xi32>
%o6odd = scf.select %even, %o6partner, %o6words : vector<4xi32>
%o6raw = low.invoke @clef_interleave_bf16(%o6even, %o6odd) : (vector<4xi32>, vector<4xi32>) -> (vector<16xbf16>)
scf.if %writes {
 %orow6 = index.assume %qrow [lt(%qrow, %queries)] : index
 vector.store %o6raw, %out[%orow6, %qcol6] : vector<16xbf16>, view<[%queries]x[%qw]xbf16>
}
%output7 = vector.divf %final7, %sumv : vector<8xf32>
%o7half = vector.fptrunc %output7 : vector<8xf32> to vector<8xbf16>
%o7words = vector.bitcast %o7half : vector<8xbf16> to vector<4xi32>
%o7partner, %o7valid = kernel.subgroup.shuffle<xor> %o7words, %i16, %i32 : vector<4xi32>, i32, i32
%o7even = scf.select %even, %o7words, %o7partner : vector<4xi32>
%o7odd = scf.select %even, %o7partner, %o7words : vector<4xi32>
%o7raw = low.invoke @clef_interleave_bf16(%o7even, %o7odd) : (vector<4xi32>, vector<4xi32>) -> (vector<16xbf16>)
scf.if %writes {
 %orow7 = index.assume %qrow [lt(%qrow, %queries)] : index
 vector.store %o7raw, %out[%orow7, %qcol7] : vector<16xbf16>, view<[%queries]x[%qw]xbf16>
}
kernel.return
}
