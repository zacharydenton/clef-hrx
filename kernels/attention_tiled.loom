%c2 = index.constant 2 : index
%c4 = index.constant 4 : index
%c8 = index.constant 8 : index
%c15 = index.constant 15 : index
%c16 = index.constant 16 : index
%c32 = index.constant 32 : index
%c64 = index.constant 64 : index
%c128 = index.constant 128 : index
%c256 = index.constant 256 : index
%i1 = scalar.constant 1 : i32
%i2 = scalar.constant 2 : i32
%i4 = scalar.constant 4 : i32
%i8 = scalar.constant 8 : i32
%i32 = scalar.constant 32 : i32
%heads = config.get @clef.heads : index
%ratio = config.get @clef.ratio : index
%qw = config.get @clef.qw : index
%kw = config.get @clef.kw : index
%keys = index.assume %key_rows [range(%key_rows, 1, 65536), le(%key_rows, %v_capacity)] : index
%vstride = index.assume %v_capacity [range(%v_capacity, 64, 65536), mul(%v_capacity, 64)] : index
%scale = config.get @clef.scale : f32
%scalev = vector.splat %scale : vector<8xf32>
%wave = index.add %waveid, %zero : index
%ll = index.rem %id, %c32 : index
%wave_local = kernel.subgroup.id : index
%lc = index.rem %ll, %c16 : index
%lg = index.div %ll, %c16 : index
%head = index.rem %wave, %heads : index
%tile = index.div %wave, %heads : index
%qbase = index.mul %tile, %c16 : index
%qr0 = index.add %qbase, %lc : index
%qpresent = index.cmp ult, %qr0, %queries : index
%qsafe = scf.select %qpresent, %qr0, %zero : index
%qr = index.assume %qsafe [lt(%qsafe, %queries)] : index
%kh = index.div %head, %ratio : index
%qc = index.mul %head, %c256 : index
%kc = index.mul %kh, %c256 : index
%qg = buffer.assume.memory_space<global> %q_buffer : buffer
%kg = buffer.assume.memory_space<global> %k_buffer : buffer
%vg = buffer.assume.memory_space<global> %v_buffer : buffer
%qview = buffer.view %qg[%offset] : buffer -> view<[%queries]x[%qw]xbf16>
%kview = buffer.view %kg[%offset] : buffer -> view<[%keys]x[%kw]xbf16>
%vview = buffer.view %vg[%offset] : buffer -> view<[%kw]x[%vstride]xbf16>
%wave_bytes = index.constant 1024 : offset
%wave_offset = index.scale %wave_local, %wave_bytes : index, offset -> offset
%low_bytes = index.constant 512 : offset
%low_offset = index.add %wave_offset, %low_bytes : offset
