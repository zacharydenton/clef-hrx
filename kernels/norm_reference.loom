// norm_reference. Shapes and storage types are compiler specializations.
amdgpu.target<gfx11-generic> @clef_target {subgroup_size = 32}
config.decl @clef.work : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.groups : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.out_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.out_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.x_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.x_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.w_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.w_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.b_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.b_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.width : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.width_float : f32
config.decl @clef.eps : f32
config.decl @clef.layer : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.weight_add : f32

kernel.def target(@clef_target) export("clef_op") @clef_op() {
 %one = index.constant 1 : index
 %threads = index.constant 64 : index
 %groups = config.get @clef.groups : index
 kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%x_buffer: buffer, %w_buffer: buffer, %b_buffer: buffer, %out_buffer: buffer) {
 %zero = index.constant 0 : index
 %one = index.constant 1 : index
 %threads = index.constant 64 : index
 %offset = index.constant 0 : offset
 %fzero = scalar.constant 0.0 : f32
 %fone = scalar.constant 1.0 : f32
 %wg = kernel.workgroup.id<x> : index
 %lane = kernel.workitem.id<x> : index
 %base = index.mul %wg, %threads : index
 %id = index.add %base, %lane : index
 %count = config.get @clef.work : index
 %out_len = config.get @clef.out_len : index
 %out_dtype = config.get @clef.out_dtype : index
 %outv = buffer.view %out_buffer[%offset] : buffer -> view<[%out_len]xf32>
%x_len = config.get @clef.x_len : index
%x_dtype = config.get @clef.x_dtype : index
%w_len = config.get @clef.w_len : index
%w_dtype = config.get @clef.w_dtype : index
%b_len = config.get @clef.b_len : index
%b_dtype = config.get @clef.b_dtype : index
 %active = index.cmp ult, %id, %count : index
 scf.if %active {

%width = config.get @clef.width : index
%wf = config.get @clef.width_float : f32
%eps = config.get @clef.eps : f32
%base_row = index.mul %id, %width : index
%layer = config.get @clef.layer : index
%has_bias = index.cmp ne, %layer, %zero : index
%mean = scf.if %has_bias -> (f32) {
%sum = scf.for %j = [%zero to %width step %one](%acc = %fzero : f32) -> (f32) {
%p = index.add %base_row, %j : index
%v = template.apply<@clef.load>(%x_dtype, %x_buffer, %x_len, %p) : (index, buffer, index, index) -> (f32)
%s = scalar.addf %acc, %v : f32
scf.yield %s : f32
}
%mean0 = scalar.divf %sum, %wf : f32
scf.yield %mean0 : f32
} else {scf.yield %fzero : f32}

%ss = scf.for %j1 = [%zero to %width step %one](%acc1 = %fzero : f32) -> (f32) {
 %p1 = index.add %base_row, %j1 : index
 %v1 = template.apply<@clef.load>(%x_dtype, %x_buffer, %x_len, %p1) : (index, buffer, index, index) -> (f32)

 %d = scalar.subf %v1, %mean : f32
 %s1 = scalar.fmaf %d, %d, %acc1 : f32
 scf.yield %s1 : f32
}
%var = scalar.divf %ss, %wf : f32
%ve = scalar.addf %var, %eps : f32
%inv = scalar.rsqrtf %ve : f32
scf.for %j2 = [%zero to %width step %one] {
 %p2 = index.add %base_row, %j2 : index
 %v2 = template.apply<@clef.load>(%x_dtype, %x_buffer, %x_len, %p2) : (index, buffer, index, index) -> (f32)
%wv = template.apply<@clef.load>(%w_dtype, %w_buffer, %w_len, %j2) : (index, buffer, index, index) -> (f32)
%bv = scf.if %has_bias -> (f32) {
%bias0 = template.apply<@clef.load>(%b_dtype, %b_buffer, %b_len, %j2) : (index, buffer, index, index) -> (f32)
scf.yield %bias0 : f32
} else {scf.yield %fzero : f32}

 %weight_add = config.get @clef.weight_add : f32
%weight = scalar.addf %wv, %weight_add : f32
 %d2 = scalar.subf %v2, %mean : f32
 %n = scalar.mulf %d2, %inv : f32
 %r = scalar.fmaf %n, %weight, %bv : f32
 template.apply<@clef.store>(%out_dtype, %out_buffer, %out_len, %p2, %r) : (index, buffer, index, index, f32) -> ()

}

 }
 kernel.return
}
