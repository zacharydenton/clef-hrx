// rope. Shapes and storage types are compiler specializations.
amdgpu.target<gfx11-generic> @clef_target {subgroup_size = 32}
config.decl @clef.work : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.groups : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.out_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.out_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.x_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.x_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.cs_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.cs_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.cswidth : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.d : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.half : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.rotary : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.width : %value: index where [range(%value, 0, 4294967295)]

kernel.def target(@clef_target) export("clef_op") @clef_op() {
 %one = index.constant 1 : index
 %threads = index.constant 64 : index
 %groups = config.get @clef.groups : index
 kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%x_buffer: buffer, %cs_buffer: buffer, %out_buffer: buffer) {
 %zero = index.constant 0 : index
 %one = index.constant 1 : index
 %threads = index.constant 64 : index
 %offset = index.constant 0 : offset
 %fzero = scalar.constant 0.0 : f32
 %fone = scalar.constant 1.0 : f32
 %wg = kernel.workgroup.id<x> : index
 %lane = kernel.workitem.id<x> : index
 %base = index.mul %wg, %threads : index
 %id = index.add %base, %lane : index
 %count = config.get @clef.work : index
 %out_len = config.get @clef.out_len : index
 %out_dtype = config.get @clef.out_dtype : index
 %outv = buffer.view %out_buffer[%offset] : buffer -> view<[%out_len]xf32>
 %x_len = config.get @clef.x_len : index
 %x_dtype = config.get @clef.x_dtype : index
 %cs_len = config.get @clef.cs_len : index
 %cs_dtype = config.get @clef.cs_dtype : index
 %active = index.cmp ult, %id, %count : index
 scf.if %active {

%dim = config.get @clef.d : index
%width = config.get @clef.width : index
%rotary = config.get @clef.rotary : index
%half = config.get @clef.half : index
%cswidth = config.get @clef.cswidth : index
%row = index.div %id, %width : index
%col = index.rem %id, %dim : index
%x = template.apply<@clef.load>(%x_dtype, %x_buffer, %x_len, %id) : (index, buffer, index, index) -> (f32)

%active_rot = index.cmp ult, %col, %rotary : index
%r = scf.if %active_rot -> (f32) {
 %first = index.cmp ult, %col, %half : index
 %plus = index.add %id, %half : index
 %minus = index.sub %id, %half : index
 %partner = scf.select %first, %plus, %minus : index
 %p = template.apply<@clef.load>(%x_dtype, %x_buffer, %x_len, %partner) : (index, buffer, index, index) -> (f32)

 %neg = scalar.negf %p : f32
 %rp = scf.select %first, %neg, %p : f32
 %cb = index.mul %row, %cswidth : index
 %ci = index.add %cb, %col : index
 %si = index.add %ci, %rotary : index
 %c = template.apply<@clef.load>(%cs_dtype, %cs_buffer, %cs_len, %ci) : (index, buffer, index, index) -> (f32)
%s = template.apply<@clef.load>(%cs_dtype, %cs_buffer, %cs_len, %si) : (index, buffer, index, index) -> (f32)

 %xc = scalar.mulf %x, %c : f32
 %r0 = scalar.fmaf %rp, %s, %xc : f32
 scf.yield %r0 : f32
} else {scf.yield %x : f32}
template.apply<@clef.store>(%out_dtype, %out_buffer, %out_len, %id, %r) : (index, buffer, index, index, f32) -> ()


 }
 kernel.return
}
