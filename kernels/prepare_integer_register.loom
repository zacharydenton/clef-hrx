  %stride = config.get @h3.prepare_plain_tiled_i8.out_stride : index
  %bits = index.constant 8 : index
  %width = config.get @h3.prepare_plain_tiled_i8.width : index
  template.apply<@clef.register_pack>(%tokens, %h, %q, %stride, %bits, %width) : (index, buffer, buffer, index, index, index)
