config.decl @h3.prepare_plain_tiled_i8.out_stride : %v: index where [range(%v, 256, 65536), mul(%v, 64)]
kernel.def target(@pack_target8) export("h3_prepare_plain_tiled_i8") @h3_prepare_plain_tiled_i8(%tokens: index) {
  %one = index.constant 1 : index
