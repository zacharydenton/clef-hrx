// One-pass BF16 Hadamard rotation and integer packing, with FP32 register retention.
// Preserves the radix-4 arithmetic and row-scale contract of prepare_integer.loom
// (h3-hrx, Apache-2.0, 95ed12f43bd3e596cbfad175c22de9560447e9e5).
// Each wave owns one 256-value group: eight adjacent values per lane. Radix-4
// stride 1 stays within registers; strides 4, 16 and 64 exchange wave operands.
// Keep the pair sums/differences and final add/subtract ordering. Do not replace
// this transform with an algebraically equivalent butterfly with other rounding.
// Entirely padded waves participate with zeros, including the row-max reduction.
template.decl @clef.register_pack(%tokens: index, %h: buffer, %q: buffer, %stride: index, %bits: index, %width: index)
template.def<@clef.register_pack> @register_pack(%tokens: index, %h: buffer, %q: buffer, %stride: index, %bits: index, %width: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %i1 = scalar.constant 1 : i32
  %i2 = scalar.constant 2 : i32
  %i4 = scalar.constant 4 : i32
  %i8 = scalar.constant 8 : i32
  %i16 = scalar.constant 16 : i32
  %i32 = scalar.constant 32 : i32
  %off0 = index.constant 0 : offset
  %row0 = kernel.workgroup.id<x> : index
  %tokens_b = index.assume %tokens [range(%tokens, 1, 1048576)] : index
  %row = index.assume %row0 [lt(%row0, %tokens_b)] : index
  %lane = kernel.workitem.id<x> : index
  %wave_lane = kernel.subgroup.lane.id : index
  %wg_lane8 = index.mul %lane, %c8 : index
  %zero = scalar.constant 0.0 : f32
  %tiny = scalar.constant 1e-30 : f32
  %inf = scalar.constant inf : f32
  %sixteenth = scalar.constant 0.0625 : f32
  %q7 = scalar.constant 7.0 : f32
  %q127 = scalar.constant 127.0 : f32
  %is8 = index.cmp eq, %bits, %c8 : index
  %qmax = scf.select %is8, %q127, %q7 : f32
  %neg_qmax = scalar.subf %zero, %qmax : f32
  %packed = index.div %c32, %bits : index
  %out_words = index.div %stride, %packed : index
  %hg = buffer.assume.memory_space<global> %h : buffer
  %qg = buffer.assume.memory_space<global> %q : buffer
  %hv = buffer.view %hg[%off0] : buffer -> view<[%tokens_b]x[%width]xbf16>
  %qv = buffer.view %qg[%off0] : buffer -> view<[%tokens_b]x[%out_words]xi32>
  %scale_elements = index.mul %tokens_b, %out_words : index
  %word_bytes = index.constant 4 : offset
  %scale_offset = index.scale %scale_elements, %word_bytes : index, offset -> offset
  %sv = buffer.view %qg[%scale_offset] : buffer -> view<[%tokens_b]xf32>
  %zero8 = vector.constant 0.0 : vector<8xf32>
  %inf8 = vector.splat %inf : vector<8xf32>
  %half2 = index.div %wave_lane, %c2 : index
  %bit2 = index.rem %half2, %c2 : index
  %low2 = index.cmp eq, %bit2, %c0 : index
  %half8 = index.div %wave_lane, %c8 : index
  %bit8 = index.rem %half8, %c2 : index
  %low8 = index.cmp eq, %bit8, %c0 : index
  %c2047 = index.constant 2047 : index
  %c2048 = index.constant 2048 : index
  %rounded_width = index.add %width, %c2047 : index
  %chunks = index.div %rounded_width, %c2048 : index
  %cache_size = index.mul %chunks, %c8 : index
  %last_col = index.sub %width, %c8 : index
  %cache_init = vector.constant 0.0 : vector<[%cache_size]xf32>
  // Unroll the row chunks so the retained vector lives in registers.
  %values, %lane_max = scf.for %chunk = [%c0 to %chunks step %c1](%cache = %cache_init : vector<[%cache_size]xf32>, %prev_max = %zero : f32) -> (vector<[%cache_size]xf32>, f32) unroll {
    %tile_base = index.mul %chunk, %c2048 : index
    %tile_col0 = index.add %wg_lane8, %tile_base : index
    %tile_active = index.cmp ult, %tile_col0, %width : index
    %tile_v = scf.if %tile_active -> (vector<8xf32>) {
      %tile_col = index.assume %tile_col0 [le(%tile_col0, %last_col), mul(%tile_col0, 8)] : index
      %tile_h = vector.load %hv[%row, %tile_col] : view<[%tokens_b]x[%width]xbf16> -> vector<8xbf16>
      %tile_f = vector.extf %tile_h : vector<8xbf16> to vector<8xf32>
      scf.yield %tile_f : vector<8xf32>
    } else {
      scf.yield %zero8 : vector<8xf32>
    }
    %tile_e0 = vector.extract %tile_v[%c0] : vector<8xf32> -> f32
    %tile_e1 = vector.extract %tile_v[%c1] : vector<8xf32> -> f32
    %tile_e2 = vector.extract %tile_v[%c2] : vector<8xf32> -> f32
    %tile_e3 = vector.extract %tile_v[%c3] : vector<8xf32> -> f32
    %tile_e4 = vector.extract %tile_v[%c4] : vector<8xf32> -> f32
    %tile_e5 = vector.extract %tile_v[%c5] : vector<8xf32> -> f32
    %tile_e6 = vector.extract %tile_v[%c6] : vector<8xf32> -> f32
    %tile_e7 = vector.extract %tile_v[%c7] : vector<8xf32> -> f32
    %tile_s01_0 = scalar.addf %tile_e0, %tile_e1 : f32
    %tile_s23_0 = scalar.addf %tile_e2, %tile_e3 : f32
    %tile_d01_0 = scalar.subf %tile_e0, %tile_e1 : f32
    %tile_d23_0 = scalar.subf %tile_e2, %tile_e3 : f32
    %tile_a0 = scalar.addf %tile_s01_0, %tile_d23_0 : f32
    %tile_a1 = scalar.subf %tile_s01_0, %tile_d23_0 : f32
    %tile_a2 = scalar.addf %tile_d01_0, %tile_s23_0 : f32
    %tile_a3 = scalar.subf %tile_s23_0, %tile_d01_0 : f32
    %tile_s01_4 = scalar.addf %tile_e4, %tile_e5 : f32
    %tile_s23_4 = scalar.addf %tile_e6, %tile_e7 : f32
    %tile_d01_4 = scalar.subf %tile_e4, %tile_e5 : f32
    %tile_d23_4 = scalar.subf %tile_e6, %tile_e7 : f32
    %tile_a4 = scalar.addf %tile_s01_4, %tile_d23_4 : f32
    %tile_a5 = scalar.subf %tile_s01_4, %tile_d23_4 : f32
    %tile_a6 = scalar.addf %tile_d01_4, %tile_s23_4 : f32
    %tile_a7 = scalar.subf %tile_s23_4, %tile_d01_4 : f32
    %tile_lo = vector.from_elements %tile_a0, %tile_a1, %tile_a2, %tile_a3 : vector<4xf32>
    %tile_hi = vector.from_elements %tile_a4, %tile_a5, %tile_a6, %tile_a7 : vector<4xf32>
    %tile_sum4 = vector.addf %tile_lo, %tile_hi : vector<4xf32>
    %tile_diff4 = vector.subf %tile_lo, %tile_hi : vector<4xf32>
    %tile_peer4, %tile_valid4 = kernel.subgroup.shuffle<xor> %tile_diff4, %i1, %i32 : vector<4xf32>, i32, i32
    %tile_outlo = vector.addf %tile_sum4, %tile_peer4 : vector<4xf32>
    %tile_outhi = vector.subf %tile_sum4, %tile_peer4 : vector<4xf32>
    %tile_b0 = vector.extract %tile_outlo[%c0] : vector<4xf32> -> f32
    %tile_b1 = vector.extract %tile_outlo[%c1] : vector<4xf32> -> f32
    %tile_b2 = vector.extract %tile_outlo[%c2] : vector<4xf32> -> f32
    %tile_b3 = vector.extract %tile_outlo[%c3] : vector<4xf32> -> f32
    %tile_b4 = vector.extract %tile_outhi[%c0] : vector<4xf32> -> f32
    %tile_b5 = vector.extract %tile_outhi[%c1] : vector<4xf32> -> f32
    %tile_b6 = vector.extract %tile_outhi[%c2] : vector<4xf32> -> f32
    %tile_b7 = vector.extract %tile_outhi[%c3] : vector<4xf32> -> f32
    %tile_s4 = vector.from_elements %tile_b0, %tile_b1, %tile_b2, %tile_b3, %tile_b4, %tile_b5, %tile_b6, %tile_b7 : vector<8xf32>
    %tile_s2_peer, %tile_s2_valid = kernel.subgroup.shuffle<xor> %tile_s4, %i2, %i32 : vector<8xf32>, i32, i32
    %tile_s2_sum = vector.addf %tile_s4, %tile_s2_peer : vector<8xf32>
    %tile_s2_fwd = vector.subf %tile_s4, %tile_s2_peer : vector<8xf32>
    %tile_s2_rev = vector.subf %tile_s2_peer, %tile_s4 : vector<8xf32>
    %tile_s2_diff = scf.select %low2, %tile_s2_fwd, %tile_s2_rev : vector<8xf32>
    %tile_s2_other, %tile_s2_valid2 = kernel.subgroup.shuffle<xor> %tile_s2_diff, %i4, %i32 : vector<8xf32>, i32, i32
    %tile_s2_plus = vector.addf %tile_s2_sum, %tile_s2_other : vector<8xf32>
    %tile_s2_minus = vector.subf %tile_s2_sum, %tile_s2_other : vector<8xf32>
    %tile_s2_result = scf.select %low2, %tile_s2_plus, %tile_s2_minus : vector<8xf32>
    %tile_s8_peer, %tile_s8_valid = kernel.subgroup.shuffle<xor> %tile_s2_result, %i8, %i32 : vector<8xf32>, i32, i32
    %tile_s8_sum = vector.addf %tile_s2_result, %tile_s8_peer : vector<8xf32>
    %tile_s8_fwd = vector.subf %tile_s2_result, %tile_s8_peer : vector<8xf32>
    %tile_s8_rev = vector.subf %tile_s8_peer, %tile_s2_result : vector<8xf32>
    %tile_s8_diff = scf.select %low8, %tile_s8_fwd, %tile_s8_rev : vector<8xf32>
    %tile_s8_other, %tile_s8_valid2 = kernel.subgroup.shuffle<xor> %tile_s8_diff, %i16, %i32 : vector<8xf32>, i32, i32
    %tile_s8_plus = vector.addf %tile_s8_sum, %tile_s8_other : vector<8xf32>
    %tile_s8_minus = vector.subf %tile_s8_sum, %tile_s8_other : vector<8xf32>
    %tile_s8_result = scf.select %low8, %tile_s8_plus, %tile_s8_minus : vector<8xf32>
    %tile_abs = vector.absf %tile_s8_result : vector<8xf32>
    %tile_finite = vector.cmpf olt, %tile_abs, %inf8 : vector<8xf32> -> vector<8xi1>
    %tile_checked = vector.select %tile_finite, %tile_abs, %inf8 : vector<8xf32>
    %tile_maxval0 = vector.extract %tile_checked[%c0] : vector<8xf32> -> f32
    %tile_max0 = scalar.maxnumf %prev_max, %tile_maxval0 : f32
    %tile_maxval1 = vector.extract %tile_checked[%c1] : vector<8xf32> -> f32
    %tile_max1 = scalar.maxnumf %tile_max0, %tile_maxval1 : f32
    %tile_maxval2 = vector.extract %tile_checked[%c2] : vector<8xf32> -> f32
    %tile_max2 = scalar.maxnumf %tile_max1, %tile_maxval2 : f32
    %tile_maxval3 = vector.extract %tile_checked[%c3] : vector<8xf32> -> f32
    %tile_max3 = scalar.maxnumf %tile_max2, %tile_maxval3 : f32
    %tile_maxval4 = vector.extract %tile_checked[%c4] : vector<8xf32> -> f32
    %tile_max4 = scalar.maxnumf %tile_max3, %tile_maxval4 : f32
    %tile_maxval5 = vector.extract %tile_checked[%c5] : vector<8xf32> -> f32
    %tile_max5 = scalar.maxnumf %tile_max4, %tile_maxval5 : f32
    %tile_maxval6 = vector.extract %tile_checked[%c6] : vector<8xf32> -> f32
    %tile_max6 = scalar.maxnumf %tile_max5, %tile_maxval6 : f32
    %tile_maxval7 = vector.extract %tile_checked[%c7] : vector<8xf32> -> f32
    %tile_max7 = scalar.maxnumf %tile_max6, %tile_maxval7 : f32
    %next_cache = scf.for %part = [%c0 to %c8 step %c1](%partial = %cache : vector<[%cache_size]xf32>) -> (vector<[%cache_size]xf32>) unroll {
      %value = vector.extract %tile_s8_result[%part] : vector<8xf32> -> f32
      %slot0 = index.mul %chunk, %c8 : index
      %slot = index.add %slot0, %part : index
      %inserted = vector.insert %value into %partial[%slot] : f32, vector<[%cache_size]xf32>
      scf.yield %inserted : vector<[%cache_size]xf32>
    }
    scf.yield %next_cache, %tile_max7 : vector<[%cache_size]xf32>, f32
  }
  // Only the row maximum crosses wave boundaries.
  %maximum = kernel.workgroup.reduce<maxnumf> %lane_max : f32
  %normal = scalar.mulf %maximum, %sixteenth : f32
  %safe_max = scalar.maxnumf %normal, %tiny : f32
  %scale = scalar.divf %safe_max, %qmax : f32
  %valid_scale = scalar.cmpf olt, %scale, %inf : f32
  %inv = scalar.divf %sixteenth, %scale : f32
  %inv8 = vector.splat %inv : vector<8xf32>
  %neg8 = vector.splat %neg_qmax : vector<8xf32>
  %qmax8 = vector.splat %qmax : vector<8xf32>
  %mask4 = scalar.constant 15 : i32
  %mask8 = scalar.constant 255 : i32
  %mask = scf.select %is8, %mask8, %mask4 : i32
  %zero_i = scalar.constant 0 : i32
  %words_per_lane = index.div %c8, %packed : index
  scf.for %chunk_out = [%c0 to %chunks step %c1] unroll {
    %tile_base = index.mul %chunk_out, %c2048 : index
    %tile_col0 = index.add %wg_lane8, %tile_base : index
    %tile_active = index.cmp ult, %tile_col0, %width : index
    %slot_base = index.mul %chunk_out, %c8 : index
    %slot0 = index.add %slot_base, %c0 : index
    %v0 = vector.extract %values[%slot0] : vector<[%cache_size]xf32> -> f32
    %slot1 = index.add %slot_base, %c1 : index
    %v1 = vector.extract %values[%slot1] : vector<[%cache_size]xf32> -> f32
    %slot2 = index.add %slot_base, %c2 : index
    %v2 = vector.extract %values[%slot2] : vector<[%cache_size]xf32> -> f32
    %slot3 = index.add %slot_base, %c3 : index
    %v3 = vector.extract %values[%slot3] : vector<[%cache_size]xf32> -> f32
    %slot4 = index.add %slot_base, %c4 : index
    %v4 = vector.extract %values[%slot4] : vector<[%cache_size]xf32> -> f32
    %slot5 = index.add %slot_base, %c5 : index
    %v5 = vector.extract %values[%slot5] : vector<[%cache_size]xf32> -> f32
    %slot6 = index.add %slot_base, %c6 : index
    %v6 = vector.extract %values[%slot6] : vector<[%cache_size]xf32> -> f32
    %slot7 = index.add %slot_base, %c7 : index
    %v7 = vector.extract %values[%slot7] : vector<[%cache_size]xf32> -> f32
    %tile_s8_result = vector.from_elements %v0, %v1, %v2, %v3, %v4, %v5, %v6, %v7 : vector<8xf32>
    scf.if %tile_active {
      %tile_scaled = vector.mulf %tile_s8_result, %inv8 : vector<8xf32>
      %tile_safe = scf.select %valid_scale, %tile_scaled, %zero8 : vector<8xf32>
      %tile_rounded = vector.roundevenf %tile_safe : vector<8xf32>
      %tile_clo = vector.maxnumf %tile_rounded, %neg8 : vector<8xf32>
      %tile_chi = vector.minnumf %tile_clo, %qmax8 : vector<8xf32>
      %tile_codes = vector.fptosi %tile_chi : vector<8xf32> to vector<8xi32>
      scf.for %tile_word = [%c0 to %words_per_lane step %c1] {
        %tile_encoded = scf.for %tile_part = [%c0 to %packed step %c1](%tile_acc = %zero_i : i32) -> (i32) {
          %tile_local0 = index.mul %tile_word, %packed : index
          %tile_local1 = index.add %tile_local0, %tile_part : index
          %tile_local = index.assume %tile_local1 [range(%tile_local1, 0, 7)] : index
          %tile_code = vector.extract %tile_codes[%tile_local] : vector<8xi32> -> i32
          %tile_masked = scalar.andi %tile_code, %mask : i32
          %tile_shift0 = index.mul %tile_part, %bits : index
          %tile_shift = index.cast %tile_shift0 : index to i32
          %tile_shifted = scalar.shli %tile_masked, %tile_shift : i32
          %tile_next = scalar.ori %tile_acc, %tile_shifted : i32
          scf.yield %tile_next : i32
        }
        %tile_out0 = index.div %tile_col0, %packed : index
        %tile_out1 = index.add %tile_out0, %tile_word : index
        %tile_out = index.assume %tile_out1 [lt(%tile_out1, %out_words)] : index
        view.store %tile_encoded, %qv[%row, %tile_out] : i32, view<[%tokens_b]x[%out_words]xi32>
      }
    }
  }
  %first = index.cmp eq, %lane, %c0 : index
  scf.if %first {
    view.store %scale, %sv[%row] : f32, view<[%tokens_b]xf32>
  }
  template.return
}
amdgpu.target<gfx11-generic> @pack_target4 {subgroup_size = 32}
config.decl @h3.prepare_plain_tiled_i4.width : %v: index where [range(%v, 256, 32768), mul(%v, 256)]
config.decl @h3.prepare_plain_tiled_i4.lanes : %v: index where [eq(%v, 256)]
config.decl @h3.prepare_plain_tiled_i4.out_stride : %v: index where [range(%v, 256, 65536), mul(%v, 64)]
kernel.def target(@pack_target4) export("h3_prepare_plain_tiled_i4") @h3_prepare_plain_tiled_i4(%tokens: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%tokens: index, %h: buffer, %q: buffer) {
  %stride = config.get @h3.prepare_plain_tiled_i4.out_stride : index
  %bits = index.constant 4 : index
  %width = config.get @h3.prepare_plain_tiled_i4.width : index
  template.apply<@clef.register_pack>(%tokens, %h, %q, %stride, %bits, %width) : (index, buffer, buffer, index, index, index)
  kernel.return
}
