%next6 = vector.mma %pl, %vf6, %part6 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
%vc7 = index.constant 112 : index
%vr7a = index.add %kc, %vc7 : index
%vr7b = index.add %vr7a, %lc : index
%vr7 = index.assume %vr7b [lt(%vr7b, %kw)] : index
%klast7 = index.sub %vstride, %c16 : index
%kb7 = index.assume %kb [le(%kb, %klast7), multiple_of(%kb, 16)] : index
%vd7 = vector.load %vview[%vr7, %kb7] : view<[%kw]x[%vstride]xbf16> -> vector<16xbf16>
%vf7 = vector.fragment<rhs> %vd7 shape [%c16, %c16] : vector<16xbf16>
%rescale7 = vector.mulf %acc7, %alpha : vector<8xf32>
%part7 = vector.mma %ph, %vf7, %rescale7 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
