// Normalize Q/K and compute gates once per token into FP32 [tokens, 4192].
// Reduction and arithmetic order match the persistent eight-value kernel.
amdgpu.target<gfx11-generic> @clef_target {subgroup_size = 32}
config.decl @clef.work : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.groups : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.out_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.out_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.qkv_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.qkv_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.a_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.a_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.b_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.b_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.al_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.al_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.dt_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.dt_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.n : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.output_len : %value: index where [range(%value, 0, 4294967295)]

kernel.def target(@clef_target) export("clef_op") @clef_op() {
 %one = index.constant 1 : index
 %threads = index.constant 64 : index
 %groups = config.get @clef.groups : index
 kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%qkv_buffer: buffer, %a_buffer: buffer, %b_buffer: buffer, %al_buffer: buffer, %dt_buffer: buffer, %out_buffer: buffer) {
 %zero = index.constant 0 : index
 %one = index.constant 1 : index
 %threads = index.constant 64 : index
 %offset = index.constant 0 : offset
 %fzero = scalar.constant 0.0 : f32
 %fone = scalar.constant 1.0 : f32
 %wg = kernel.workgroup.id<x> : index
 %lane = kernel.workitem.id<x> : index
 %base = index.mul %wg, %threads : index
 %id = index.add %base, %lane : index
 %count = config.get @clef.work : index
 %out_len = config.get @clef.out_len : index
 %out_dtype = config.get @clef.out_dtype : index
 %outv = buffer.view %out_buffer[%offset] : buffer -> view<[%out_len]xf32>
 %qkv_len = config.get @clef.qkv_len : index
 %qkv_dtype = config.get @clef.qkv_dtype : index
 %a_len = config.get @clef.a_len : index
 %a_dtype = config.get @clef.a_dtype : index
 %b_len = config.get @clef.b_len : index
 %b_dtype = config.get @clef.b_dtype : index
 %al_len = config.get @clef.al_len : index
 %al_dtype = config.get @clef.al_dtype : index
 %dt_len = config.get @clef.dt_len : index
 %dt_dtype = config.get @clef.dt_dtype : index
 %active = index.cmp ult, %id, %count : index
 scf.if %active {

%dim = index.constant 128 : index
%wave_width = index.constant 32 : index
%keyheads = index.constant 16 : index
%heads = index.constant 48 : index
%three = index.constant 3 : index
%two = index.constant 2 : index
%keyoff = index.constant 2048 : index
%gateoff = index.constant 4096 : index
%qwidth = index.constant 10240 : index
%pwidth = index.constant 4192 : index
%wave = index.div %id, %wave_width : index
%ll = index.rem %id, %wave_width : index
%keyhead = index.rem %wave, %keyheads : index
%t = index.div %wave, %keyheads : index
%keybase = index.mul %keyhead, %dim : index
%qb0 = index.mul %t, %qwidth : index
%qb = index.add %qb0, %keybase : index
%kb = index.add %qb, %keyoff : index
%pb0 = index.mul %t, %pwidth : index
%pb = index.add %pb0, %keybase : index
%pkb = index.add %pb, %keyoff : index
%eps = scalar.constant 1.0e-6 : f32
%qscale = scalar.constant 0.08838834764831845 : f32
%j0 = index.constant 0 : index
%dim0 = index.add %ll, %j0 : index
%j1 = index.constant 32 : index
%dim1 = index.add %ll, %j1 : index
%j2 = index.constant 64 : index
%dim2 = index.add %ll, %j2 : index
%j3 = index.constant 96 : index
%dim3 = index.add %ll, %j3 : index
%qi0 = index.add %qb, %dim0 : index
%q0 = template.apply<@clef.load>(%qkv_dtype, %qkv_buffer, %qkv_len, %qi0) : (index, buffer, index, index) -> (f32)
%qsq0 = scalar.fmaf %q0, %q0, %fzero : f32
%ki0 = index.add %kb, %dim0 : index
%k0 = template.apply<@clef.load>(%qkv_dtype, %qkv_buffer, %qkv_len, %ki0) : (index, buffer, index, index) -> (f32)
%ksq0 = scalar.fmaf %k0, %k0, %fzero : f32
%qi1 = index.add %qb, %dim1 : index
%q1 = template.apply<@clef.load>(%qkv_dtype, %qkv_buffer, %qkv_len, %qi1) : (index, buffer, index, index) -> (f32)
%qsq1 = scalar.fmaf %q1, %q1, %qsq0 : f32
%ki1 = index.add %kb, %dim1 : index
%k1 = template.apply<@clef.load>(%qkv_dtype, %qkv_buffer, %qkv_len, %ki1) : (index, buffer, index, index) -> (f32)
%ksq1 = scalar.fmaf %k1, %k1, %ksq0 : f32
%qi2 = index.add %qb, %dim2 : index
%q2 = template.apply<@clef.load>(%qkv_dtype, %qkv_buffer, %qkv_len, %qi2) : (index, buffer, index, index) -> (f32)
%qsq2 = scalar.fmaf %q2, %q2, %qsq1 : f32
%ki2 = index.add %kb, %dim2 : index
%k2 = template.apply<@clef.load>(%qkv_dtype, %qkv_buffer, %qkv_len, %ki2) : (index, buffer, index, index) -> (f32)
%ksq2 = scalar.fmaf %k2, %k2, %ksq1 : f32
%qi3 = index.add %qb, %dim3 : index
%q3 = template.apply<@clef.load>(%qkv_dtype, %qkv_buffer, %qkv_len, %qi3) : (index, buffer, index, index) -> (f32)
%qsq3 = scalar.fmaf %q3, %q3, %qsq2 : f32
%ki3 = index.add %kb, %dim3 : index
%k3 = template.apply<@clef.load>(%qkv_dtype, %qkv_buffer, %qkv_len, %ki3) : (index, buffer, index, index) -> (f32)
%ksq3 = scalar.fmaf %k3, %k3, %ksq2 : f32
%qsum = kernel.subgroup.reduce<addf> %qsq3 : f32
%qeps = scalar.addf %qsum, %eps : f32
%qinv = scalar.rsqrtf %qeps : f32
%ksum = kernel.subgroup.reduce<addf> %ksq3 : f32
%keps = scalar.addf %ksum, %eps : f32
%kinv = scalar.rsqrtf %keps : f32
%qnorm0 = scalar.mulf %q0, %qinv : f32
%qn0 = scalar.mulf %qnorm0, %qscale : f32
%kn0 = scalar.mulf %k0, %kinv : f32
%qnorm1 = scalar.mulf %q1, %qinv : f32
%qn1 = scalar.mulf %qnorm1, %qscale : f32
%kn1 = scalar.mulf %k1, %kinv : f32
%qnorm2 = scalar.mulf %q2, %qinv : f32
%qn2 = scalar.mulf %qnorm2, %qscale : f32
%kn2 = scalar.mulf %k2, %kinv : f32
%qnorm3 = scalar.mulf %q3, %qinv : f32
%qn3 = scalar.mulf %qnorm3, %qscale : f32
%kn3 = scalar.mulf %k3, %kinv : f32
%oq0 = index.add %pb, %dim0 : index
template.apply<@clef.store>(%out_dtype, %out_buffer, %out_len, %oq0, %qn0) : (index, buffer, index, index, f32) -> ()
%ok0 = index.add %pkb, %dim0 : index
template.apply<@clef.store>(%out_dtype, %out_buffer, %out_len, %ok0, %kn0) : (index, buffer, index, index, f32) -> ()
%oq1 = index.add %pb, %dim1 : index
template.apply<@clef.store>(%out_dtype, %out_buffer, %out_len, %oq1, %qn1) : (index, buffer, index, index, f32) -> ()
%ok1 = index.add %pkb, %dim1 : index
template.apply<@clef.store>(%out_dtype, %out_buffer, %out_len, %ok1, %kn1) : (index, buffer, index, index, f32) -> ()
%oq2 = index.add %pb, %dim2 : index
template.apply<@clef.store>(%out_dtype, %out_buffer, %out_len, %oq2, %qn2) : (index, buffer, index, index, f32) -> ()
%ok2 = index.add %pkb, %dim2 : index
template.apply<@clef.store>(%out_dtype, %out_buffer, %out_len, %ok2, %kn2) : (index, buffer, index, index, f32) -> ()
%oq3 = index.add %pb, %dim3 : index
template.apply<@clef.store>(%out_dtype, %out_buffer, %out_len, %oq3, %qn3) : (index, buffer, index, index, f32) -> ()
%ok3 = index.add %pkb, %dim3 : index
template.apply<@clef.store>(%out_dtype, %out_buffer, %out_len, %ok3, %kn3) : (index, buffer, index, index, f32) -> ()
%is_gate = index.cmp ult, %ll, %three : index
scf.if %is_gate {
%head0 = index.mul %keyhead, %three : index
%head = index.add %head0, %ll : index
%al = template.apply<@clef.load>(%al_dtype, %al_buffer, %al_len, %head) : (index, buffer, index, index) -> (f32)
%dt = template.apply<@clef.load>(%dt_dtype, %dt_buffer, %dt_len, %head) : (index, buffer, index, index) -> (f32)
%ea = scalar.expf<afn> %al : f32
%ab0 = index.mul %t, %heads : index
%ai = index.add %ab0, %head : index
%aa = template.apply<@clef.load>(%a_dtype, %a_buffer, %a_len, %ai) : (index, buffer, index, index) -> (f32)
%bb = template.apply<@clef.load>(%b_dtype, %b_buffer, %b_len, %ai) : (index, buffer, index, index) -> (f32)
 %adt = scalar.addf %aa, %dt : f32
 %negabs0 = scalar.absf %adt : f32
 %negabs = scalar.negf %negabs0 : f32
 %expneg = scalar.expf<afn> %negabs : f32
 %loge = scalar.addf %fone, %expneg : f32
 %log = scalar.logf<afn> %loge : f32
 %positive = scalar.cmpf ogt, %adt, %fzero : f32
 %amax = scf.select %positive, %adt, %fzero : f32
 %sp = scalar.addf %amax, %log : f32
 %gpos = scalar.mulf %ea, %sp : f32
 %g = scalar.negf %gpos : f32
 %decay = scalar.expf<afn> %g : f32
 %nb = scalar.negf %bb : f32
 %eb = scalar.expf<afn> %nb : f32
 %bd = scalar.addf %fone, %eb : f32
 %beta0 = scalar.divf %fone, %bd : f32
 %betabf = scalar.fptrunc %beta0 : f32 to bf16
 %beta = scalar.extf %betabf : bf16 to f32

%gatebase = index.add %pb0, %gateoff : index
%head2 = index.mul %head, %two : index
%gi = index.add %gatebase, %head2 : index
%bi = index.add %gi, %one : index
template.apply<@clef.store>(%out_dtype, %out_buffer, %out_len, %gi, %decay) : (index, buffer, index, index, f32) -> ()
template.apply<@clef.store>(%out_dtype, %out_buffer, %out_len, %bi, %beta) : (index, buffer, index, index, f32) -> ()
}
}
kernel.return
}
