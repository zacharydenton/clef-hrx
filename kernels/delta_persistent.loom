config.decl @clef.dt_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.dt_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.n : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.output_len : %value: index where [range(%value, 0, 4294967295)]

kernel.def target(@clef_target) export("clef_op") @clef_op() {
 %one = index.constant 1 : index
 %threads = index.constant 64 : index
 %groups = config.get @clef.groups : index
 kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%qkv_buffer: buffer, %a_buffer: buffer, %b_buffer: buffer, %al_buffer: buffer, %dt_buffer: buffer, %out_buffer: buffer) {
