%bb = template.apply<@clef.load>(%b_dtype, %b_buffer, %b_len, %ai) : (index, buffer, index, index) -> (f32)
 %adt = scalar.addf %aa, %dt : f32
 %negabs0 = scalar.absf %adt : f32
 %negabs = scalar.negf %negabs0 : f32
 %expneg = scalar.expf<afn> %negabs : f32
 %loge = scalar.addf %fone, %expneg : f32
 %log = scalar.logf<afn> %loge : f32
 %positive = scalar.cmpf ogt, %adt, %fzero : f32
 %amax = scf.select %positive, %adt, %fzero : f32
 %sp = scalar.addf %amax, %log : f32
