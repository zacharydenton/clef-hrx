 %b_len = config.get @clef.b_len : index
 %b_dtype = config.get @clef.b_dtype : index
 %al_len = config.get @clef.al_len : index
 %al_dtype = config.get @clef.al_dtype : index
 %dt_len = config.get @clef.dt_len : index
 %dt_dtype = config.get @clef.dt_dtype : index
 %active = index.cmp ult, %id, %count : index
 scf.if %active {

%dim = index.constant 128 : index
%wave_width = index.constant 32 : index
%values = index.constant 8 : index
%waves_head = index.constant 16 : index
%wave = index.div %id, %wave_width : index
%ll = index.rem %id, %wave_width : index
%leader = index.cmp eq, %ll, %zero : index
%head = index.div %wave, %waves_head : index
%part = index.rem %wave, %waves_head : index
%channel = index.mul %part, %values : index
%vwidth = index.constant 6144 : index
%qwidth = index.constant 10240 : index
%heads = index.constant 48 : index
%three = index.constant 3 : index
%keyoff = index.constant 2048 : index
