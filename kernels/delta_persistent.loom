%qn0 = scalar.mulf %qnorm0, %qscale : f32
%kn0 = scalar.mulf %k0, %kinv : f32
%qnorm1 = scalar.mulf %q1, %qinv : f32
%qn1 = scalar.mulf %qnorm1, %qscale : f32
%kn1 = scalar.mulf %k1, %kinv : f32
%qnorm2 = scalar.mulf %q2, %qinv : f32
%qn2 = scalar.mulf %qnorm2, %qscale : f32
%kn2 = scalar.mulf %k2, %kinv : f32
%qnorm3 = scalar.mulf %q3, %qinv : f32
%qn3 = scalar.mulf %qnorm3, %qscale : f32
%kn3 = scalar.mulf %k3, %kinv : f32
