// chunk_pair. Shapes and storage types are compiler specializations.
amdgpu.target<gfx11-generic> @clef_target {subgroup_size = 32}
config.decl @clef.work : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.groups : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.out_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.out_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.q_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.q_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.k_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.k_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.b_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.b_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.g_len : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.g_dtype : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.n : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.nn : %value: index where [range(%value, 0, 4294967295)]
config.decl @clef.twon : %value: index where [range(%value, 0, 4294967295)]

kernel.def target(@clef_target) export("clef_op") @clef_op() {
 %one = index.constant 1 : index
 %threads = index.constant 64 : index
 %groups = config.get @clef.groups : index
 kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%q_buffer: buffer, %k_buffer: buffer, %b_buffer: buffer, %g_buffer: buffer, %out_buffer: buffer) {
 %zero = index.constant 0 : index
 %one = index.constant 1 : index
 %threads = index.constant 64 : index
 %offset = index.constant 0 : offset
 %fzero = scalar.constant 0.0 : f32
 %fone = scalar.constant 1.0 : f32
 %wg = kernel.workgroup.id<x> : index
 %lane = kernel.workitem.id<x> : index
 %base = index.mul %wg, %threads : index
 %id = index.add %base, %lane : index
 %count = config.get @clef.work : index
 %out_len = config.get @clef.out_len : index
 %out_dtype = config.get @clef.out_dtype : index
 %outv = buffer.view %out_buffer[%offset] : buffer -> view<[%out_len]xf32>
 %q_len = config.get @clef.q_len : index
 %q_dtype = config.get @clef.q_dtype : index
 %k_len = config.get @clef.k_len : index
 %k_dtype = config.get @clef.k_dtype : index
 %b_len = config.get @clef.b_len : index
 %b_dtype = config.get @clef.b_dtype : index
 %g_len = config.get @clef.g_len : index
 %g_dtype = config.get @clef.g_dtype : index
 %active = index.cmp ult, %id, %count : index
 scf.if %active {

%n = config.get @clef.n : index
%nn = config.get @clef.nn : index
%dim = index.constant 128 : index
%twon = config.get @clef.twon : index
%head = index.div %id, %nn : index
%cell = index.rem %id, %nn : index
%row = index.div %cell, %n : index
%col = index.rem %cell, %n : index
%hb = index.mul %head, %n : index
%ri = index.add %hb, %row : index
%ci = index.add %hb, %col : index
%rb = index.mul %ri, %dim : index
%cb = index.mul %ci, %dim : index
%ob = index.mul %ri, %twon : index
%oi = index.add %ob, %col : index
%oi2 = index.add %oi, %n : index
%lower = index.cmp ule, %col, %row : index
%l, %gamma = scf.if %lower -> (f32,f32) {
 %gr = template.apply<@clef.load>(%g_dtype, %g_buffer, %g_len, %ri) : (index, buffer, index, index) -> (f32)
%gc = template.apply<@clef.load>(%g_dtype, %g_buffer, %g_len, %ci) : (index, buffer, index, index) -> (f32)

 %diff = scalar.subf %gr, %gc : f32
 %decay = scalar.expf<afn> %diff : f32
 %qd, %kd = scf.for %j = [%zero to %dim step %one](%qa = %fzero : f32, %ka = %fzero : f32) -> (f32,f32) {
  %rp = index.add %rb, %j : index
  %cp = index.add %cb, %j : index
  %q = template.apply<@clef.load>(%q_dtype, %q_buffer, %q_len, %rp) : (index, buffer, index, index) -> (f32)
%b = template.apply<@clef.load>(%b_dtype, %b_buffer, %b_len, %rp) : (index, buffer, index, index) -> (f32)
%k = template.apply<@clef.load>(%k_dtype, %k_buffer, %k_len, %cp) : (index, buffer, index, index) -> (f32)

  %qn = scalar.fmaf %q, %k, %qa : f32
  %kn = scalar.fmaf %b, %k, %ka : f32
  scf.yield %qn, %kn : f32,f32
 }
 %qscaled = scalar.mulf %qd, %decay : f32
 %kscaled = scalar.mulf %kd, %decay : f32
 %neg = scalar.negf %kscaled : f32
 %strict = index.cmp ult, %col, %row : index
 %lv = scf.select %strict, %neg, %fzero : f32
 scf.yield %lv, %qscaled : f32,f32
} else {scf.yield %fzero, %fzero : f32,f32}
view.store %l, %outv[%oi] : f32, view<[%out_len]xf32>
view.store %gamma, %outv[%oi2] : f32, view<[%out_len]xf32>

 }
 kernel.return
}
